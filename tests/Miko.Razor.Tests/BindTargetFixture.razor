@namespace Miko.Razor.Tests
@inherits Miko.Components.ComponentBase
@* ISSUE-115: a component following Blazor's two-way binding contract —
   `T Checked` paired with `EventCallback<T> CheckedChanged`. *@
<div class="bind-target @(Checked ? "is-checked" : "is-unchecked")" @onclick="Toggle"></div>

@code {
    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    private async Task Toggle(Miko.Events.MouseEventArgs _)
    {
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
