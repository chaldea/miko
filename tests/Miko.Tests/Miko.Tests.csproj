<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Native SkiaSharp libraries for headless Linux (e.g. ubuntu-latest CI).
         The base SkiaSharp package ships no native libs; without this the tests
         fail to load linux-x64/native/libSkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Miko\Miko.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestAssets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- UAX #9 conformance data (subsets generated by tools/Miko.UnicodeGen, ISSUE-157). -->
    <None Update="TestAssets\Unicode\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- res:// 路径解析测试的素材。清单名为 Miko.Tests.TestAssets.Resources.*，
         测试断言不含程序集名的逻辑路径（res://TestAssets/Resources/logo.svg）也能命中。 -->
    <EmbeddedResource Include="TestAssets\Resources\**\*" />
  </ItemGroup>

  <!-- White-box: reads rendered pixels through SkiaSharp. Miko keeps Skia out of its public surface
       (ISSUE-162), so the package is referenced here and the engine is driven through the shim below. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <!-- TextShapingTests calls the HarfBuzz shaper directly. -->
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.2" />
    <Compile Include="..\Shared\SkiaCanvasExtensions.cs" Link="Shared\SkiaCanvasExtensions.cs" />
  </ItemGroup>

</Project>