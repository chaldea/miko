@page "/"
<ConfigProvider IonicTheme="@Theme.Current">
<IonPage Class="@(Theme.IsDark ? "demo-dark" : null)">
    <IonHeader>
        <IonToolbar>
            <IonTitle>Ionic Framework</IonTitle>
        </IonToolbar>
    </IonHeader>
        
    <IonContent Fullscreen>
        <IonList Lines="full">
            <IonItem>
                <Start><IonIcon Icon="@Ionicons.Moon"></IonIcon></Start>
                <ChildContent>
                    <IonToggle @bind-Checked="Theme.IsDark">Dark Mode</IonToggle>
                </ChildContent>
            </IonItem>
        </IonList>
            
        <IonList>
            @foreach (var component in ComponentService.GetComponents())
            {
                <IonItem Href="@component.Router">
                    <Start>
                        <IonIcon Icon="@component.Icon" Class="component-icon component-icon-primary"></IonIcon>
                    </Start>
                    <ChildContent>
                        @component.Name
                    </ChildContent>
                </IonItem>
            }
        </IonList>
    </IonContent>
</IonPage>
</ConfigProvider>

@code {
    [Inject] public ComponentService ComponentService { get; set; } = null!;
    [Inject] public ThemeService Theme { get; set; } = null!;
}
