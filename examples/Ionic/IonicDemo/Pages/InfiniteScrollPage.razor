@page "/infinite-scroll"

@* NOTE: the original demo loads gravatar images over the network for each row. Miko's demo
   resources are embedded, so the bundled avatar asset is used instead. *@

<IonPage>
    <IonHeader>
        <IonToolbar>
            <Start>
                <IonBackButton DefaultHref="/"></IonBackButton>
            </Start>
            <ChildContent>
                <IonTitle>Infinite Scroll</IonTitle>
            </ChildContent>
        </IonToolbar>
    </IonHeader>
    <IonContent Fullscreen>
        <IonList>
            @foreach (var user in _items)
            {
                <IonItem>
                    <Start>
                        <IonAvatar>
                            <img src="res://IonicDemo.Assets.avatar.svg" />
                        </IonAvatar>
                    </Start>
                    <ChildContent>
                        <IonLabel>
                            <h2>@user.Name</h2>
                            <p>Created @user.Created</p>
                        </IonLabel>
                    </ChildContent>
                </IonItem>
            }
        </IonList>

        <IonInfiniteScroll @ref="_infiniteScroll" Threshold="100px" OnInfinite="@HandleInfinite">
            <IonInfiniteScrollContent LoadingSpinner="bubbles" LoadingText="Loading more data...">
            </IonInfiniteScrollContent>
        </IonInfiniteScroll>
    </IonContent>
</IonPage>
