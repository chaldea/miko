@page "/select"

@* Every select opens an overlay on tap. `Interface` picks which one — alert (the default),
   action-sheet, popover, or modal — mirroring Ionic's `interface` property. *@

<IonPage>
    <IonHeader>
        <IonToolbar>
            <Start>
                <IonBackButton DefaultHref="/"></IonBackButton>
            </Start>
            <ChildContent>
                <IonTitle>Select</IonTitle>
            </ChildContent>
        </IonToolbar>
    </IonHeader>
    <IonContent Fullscreen>
        <IonList>
            <IonListHeader Lines="full">
                <IonLabel>Select Trip</IonLabel>
            </IonListHeader>

            <IonItem>
                <IonSelect Label="Origin" LabelPlacement="stacked" Placeholder="Select Airport">
                    <IonSelectOption Value="madison">Madison (MSN)</IonSelectOption>
                    <IonSelectOption Value="chicago">Chicago (ORD)</IonSelectOption>
                    <IonSelectOption Value="austin">Austin (AUS)</IonSelectOption>
                </IonSelect>
            </IonItem>

            <IonItem>
                <IonSelect Label="Destination" LabelPlacement="stacked" Placeholder="Select Airport">
                    <IonSelectOption Value="newyork">New York (JFK)</IonSelectOption>
                    <IonSelectOption Value="honolulu">Honolulu (HNL)</IonSelectOption>
                    <IonSelectOption Value="baltimore">Baltimore (BWI)</IonSelectOption>
                </IonSelect>
            </IonItem>

            <IonItem>
                <IonSelect Label="Passengers" LabelPlacement="stacked" Value="1">
                    <IonSelectOption Value="1">1 Adult</IonSelectOption>
                    <IonSelectOption Value="2">2 Adults</IonSelectOption>
                    <IonSelectOption Value="3">3 Adults</IonSelectOption>
                    <IonSelectOption Value="4">4 Adults</IonSelectOption>
                </IonSelect>
            </IonItem>

            <IonItem Lines="full">
                <IonSelect Label="Add-ons" LabelPlacement="stacked" Placeholder="Select Multiple Add-ons" Multiple>
                    <IonSelectOption Value="firstclass">First Class</IonSelectOption>
                    <IonSelectOption Value="bag">Additional Bag</IonSelectOption>
                    <IonSelectOption Value="headphones">Headphones</IonSelectOption>
                    <IonSelectOption Value="wifi">Inflight WiFi</IonSelectOption>
                </IonSelect>
            </IonItem>
        </IonList>

        <IonList>
            <IonListHeader>
                <IonLabel>Select Interfaces</IonLabel>
            </IonListHeader>

            <IonItem>
                <IonSelect Label="Gender" LabelPlacement="stacked" Placeholder="Popover Interface"
                           Interface="popover">
                    <IonSelectOption Value="f">Female</IonSelectOption>
                    <IonSelectOption Value="m">Male</IonSelectOption>
                </IonSelect>
            </IonItem>

            <IonItem>
                <IonSelect Label="Mute Notifications" LabelPlacement="stacked" Placeholder="Action Sheet Interface"
                           Interface="action-sheet">
                    <IonSelectOption Value="mute_15">For 15 Minutes</IonSelectOption>
                    <IonSelectOption Value="mute_1">For 1 Hour</IonSelectOption>
                    <IonSelectOption Value="mute_23">For 24 Hours</IonSelectOption>
                    <IonSelectOption Value="mute_inf">Until I turn it back on</IonSelectOption>
                </IonSelect>
            </IonItem>

            <IonItem Lines="full">
                <IonSelect Label="Seat" LabelPlacement="stacked" Placeholder="Modal Interface"
                           Interface="modal" InterfaceHeader="Choose a seat">
                    <IonSelectOption Value="aisle">Aisle</IonSelectOption>
                    <IonSelectOption Value="window">Window</IonSelectOption>
                    <IonSelectOption Value="middle">Middle</IonSelectOption>
                </IonSelect>
            </IonItem>
        </IonList>
    </IonContent>
</IonPage>
@code {

}
