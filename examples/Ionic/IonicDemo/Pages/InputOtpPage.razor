@page "/input-otp"

@* NOTE: Miko.Ionic has no IonInputOtp component (Ionic's <ion-input-otp> with its `separators`
   prop, ionComplete event and setFocus() method). The surrounding page is migrated as-is and the
   OTP boxes are approximated with plain IonInput fields so the layout is representative. Replace
   this block once an IonInputOtp port lands. *@

<IonPage>
    <IonHeader>
        <IonToolbar>
            <Start>
                <IonBackButton DefaultHref="/"></IonBackButton>
            </Start>
            <ChildContent>
                <IonTitle>Input OTP</IonTitle>
            </ChildContent>
        </IonToolbar>
    </IonHeader>
    <IonContent>
        <div class="ion-padding ion-text-center">
            <h2>Enter Verification Code</h2>
            <p>Please enter the 4-digit code sent to your device</p>

            <div class="otp-row ion-margin-top">
                @for (var i = 0; i < 4; i++)
                {
                    <IonInput Class="otp-box" Fill="outline"></IonInput>
                }
            </div>

            <p>Didn't get the code? <IonText Color="primary">Resend Code</IonText></p>
        </div>
    </IonContent>
</IonPage>
@code {

}
