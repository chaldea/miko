@namespace IonicComponents.Components
@inherits IonicComponentBase

<div class="playground">
    <div class="playground-container">
        <div class="playground-preview" style="@_preview">
            <div class="container @Class" style="@_container">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code
{
    private Style? _preview;
    private Style? _container;
    [Parameter] public int? Columns { get; set; }
    [Parameter] public int? Rows { get; set; }
    [Parameter] public Length? Height { get; set; }
    [Parameter] public Length? Width { get; set; }
    [Parameter] public FlexDirection Direction { get; set; } = FlexDirection.Row;
    [Parameter] public bool Stretch { get; set; }
    [Parameter] public bool Wrap { get; set; }
    [Parameter] public bool Fit { get; set; }

    protected override void OnParametersSet()
    {
        _preview = new Style()
        {
            Height = Height,
        };
        _container = new Style
        {
            Width = Width,
            Height = Fit ? Percent(100) : null,
            FlexDirection = Direction,
            AlignItems = Stretch ? AlignItems.Stretch : null,
            FlexWrap = Wrap ? FlexWrap.Wrap : null,
        };

        if (Columns != null && Rows != null)
        {
            _container.Display = Display.Grid;
            _container.GridTemplateColumns = Enumerable.Repeat(GridTrackSize.Auto, Columns.Value).ToList();
            _container.GridTemplateRows = Enumerable.Repeat(GridTrackSize.Auto, Rows.Value).ToList();
            _container.JustifyItems = JustifyItems.Center;
        }
    }
}
