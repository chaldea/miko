@page "/chip"

<h1>IonChip</h1>

<p>
    Chips represent complex entities in small blocks, such as a contact. A chip can contain several different elements
    such as avatars, text, and icons.
</p>

<h2>Basic Usage</h2>

<Playground Height="Px(200)">
    <IonChip>Default</IonChip>
    <IonChip Disabled>Default</IonChip>
    <IonChip Outline>Default</IonChip>
</Playground>

<h2>Slotting Components and Icons</h2>


<Playground Height="Px(200)">
    <IonChip>
        <IonAvatar>
            <img src="res://IonicComponents.Resources.avatar.svg" />
        </IonAvatar>
        <IonLabel>Avatar Chip</IonLabel>
        <IonIcon Icon="@Ionicons.CloseCircle"></IonIcon>
    </IonChip>
    <IonChip>
        <IonIcon Icon="@Ionicons.Pin" Color="primary"></IonIcon>
        <IonLabel>Icon Chip</IonLabel>
        <IonIcon Icon="@Ionicons.Close"></IonIcon>
    </IonChip>
</Playground>

<h2>Theming</h2>

<h3>Colors</h3>

<Playground Height="Px(200)" Width="Px(440)" Wrap>
    <IonChip>Default</IonChip>
    <IonChip Color="primary">Primary</IonChip>
    <IonChip Color="secondary">Secondary</IonChip>
    <IonChip Color="tertiary">Tertiary</IonChip>
    <IonChip Color="success">Success</IonChip>
    <IonChip Color="warning">Warning</IonChip>
    <IonChip Color="danger">Danger</IonChip>
    <IonChip Color="light">Light</IonChip>
    <IonChip Color="medium">Medium</IonChip>
    <IonChip Color="dark">Dark</IonChip>
</Playground>
