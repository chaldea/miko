            <Start>
                <IonIcon Icon="@Ionicons.Airplane"></IonIcon>
            </Start>
            <ChildContent>
                <IonLabel>Airplane Mode</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonIcon Icon="@Ionicons.Wifi"></IonIcon>
            </Start>
            <ChildContent>
                <IonLabel>Wi-Fi</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonIcon Icon="@Ionicons.Bluetooth"></IonIcon>
            </Start>
            <ChildContent>
                <IonLabel>Bluetooth</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonIcon Icon="@Ionicons.Call"></IonIcon>
            </Start>
            <ChildContent>
                <IonLabel>Cellular</IonLabel>
            </ChildContent>
        </IonItem>
    </IonList>

    <IonList Style="@_listStyle">
        <IonItem>
            <Start>
                <IonAvatar>
                    <img src="res://IonicComponents.Resources.avatar.svg" />
                </IonAvatar>
            </Start>
            <ChildContent>
                <IonLabel>Huey</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonAvatar>
                    <img src="res://IonicComponents.Resources.avatar.svg" />
                </IonAvatar>
            </Start>
            <ChildContent>
                <IonLabel>Dewey</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonAvatar>
                    <img src="res://IonicComponents.Resources.avatar.svg" />
                </IonAvatar>
            </Start>
            <ChildContent>
                <IonLabel>Louie</IonLabel>
            </ChildContent>
        </IonItem>
        <IonItem>
            <Start>
                <IonAvatar>
                    <img src="res://IonicComponents.Resources.avatar.svg" />
