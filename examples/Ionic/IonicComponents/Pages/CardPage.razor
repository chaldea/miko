@page "/card"

<h1>IonCard</h1>

<p>
    Cards are containers that display content such as text, images, buttons, and lists. A card can be a single
    component, but is often made up of a header, title, subtitle, and content. Cards are broken up into several
    components to accommodate this structure: card header, card title, card subtitle, and card content.
</p>

<h2>Basic Usage</h2>

<Playground Width="Px(400)" Height="Px(200)">
    <IonCard>
        <IonCardHeader>
            <IonCardTitle>Card Title</IonCardTitle>
            <IonCardSubtitle>Card Subtitle</IonCardSubtitle>
        </IonCardHeader>

        <IonCardContent>Here's a small text description for the card content. Nothing more, nothing less.
        </IonCardContent>
    </IonCard>
</Playground>

<h2>Media Cards</h2>

<Playground Width="Px(400)" Height="Px(350)">
    <IonCard>
        <img src="res://IonicComponents.Resources.card-media.png" />
        <IonCardHeader>
            <IonCardTitle>Card Title</IonCardTitle>
            <IonCardSubtitle>Card Subtitle</IonCardSubtitle>
        </IonCardHeader>
        <IonCardContent>Here's a small text description for the card content. Nothing more, nothing less.
        </IonCardContent>
    </IonCard>
</Playground>

<h2>Card Buttons</h2>

<Playground Width="Px(400)" Height="Px(300)">
    <IonCard>
        <IonCardHeader>
            <IonCardTitle>Card Title</IonCardTitle>
            <IonCardSubtitle>Card Subtitle</IonCardSubtitle>
        </IonCardHeader>

        <IonCardContent>Here's a small text description for the card content. Nothing more, nothing less.
        </IonCardContent>

        <IonButton Fill="clear">Action 1</IonButton>
        <IonButton Fill="clear">Action 2</IonButton>
    </IonCard>
</Playground>

<h2>List Card</h2>
<Playground Width="Px(400)" Height="Px(400)">
    <IonCard>
        <IonCardHeader>
            <IonCardTitle>Card Title</IonCardTitle>
            <IonCardSubtitle>Card Subtitle</IonCardSubtitle>
        </IonCardHeader>
        <IonCardContent>
            <IonList>
                <IonItem>
                    <Start>
                        <IonThumbnail>
                            <img src="res://IonicComponents.Resources.card-media.png" />
                        </IonThumbnail>
                    </Start>
                    <ChildContent>
                        <IonLabel>Item</IonLabel>
                    </ChildContent>
                </IonItem>

                <IonItem>
                    <Start>
                        <IonThumbnail>
                            <img src="res://IonicComponents.Resources.card-media.png" />
                        </IonThumbnail>
                    </Start>
                    <ChildContent>
                        <IonLabel>Item</IonLabel>
                    </ChildContent>
                </IonItem>

                <IonItem>
                    <Start>
                        <IonThumbnail>
                            <img src="res://IonicComponents.Resources.card-media.png" />
                        </IonThumbnail>
                    </Start>
                    <ChildContent>
                        <IonLabel>Item</IonLabel>
                    </ChildContent>
                </IonItem>

                <IonItem>
                    <Start>
                        <IonThumbnail>
                            <img src="res://IonicComponents.Resources.card-media.png" />
                        </IonThumbnail>
                    </Start>
                    <ChildContent>
                        <IonLabel>Item</IonLabel>
                    </ChildContent>
                </IonItem>
            </IonList>
        </IonCardContent>
    </IonCard>
</Playground>

