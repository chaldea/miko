@page "/"
@namespace MikoApp.Localization.Pages
@inject AppLanguage Language
@inject IStringLocalizer<SharedResource> L

<div class="content">
    <h1 class="title">@L["HomeTitle"]</h1>
    <p class="intro">@L["HomeIntro"]</p>

    <div class="card">
        <h2 class="card-title">@L["FormattingTitle"]</h2>
        @* Formatting uses the current culture, which AppLanguage switches with the strings. *@
        <div class="row"><span class="label">@L["Today"]</span><span class="value">@Today.ToString("D")</span></div>
        <div class="row"><span class="label">@L["Price"]</span><span class="value">@Price.ToString("C")</span></div>
        <div class="row"><span class="label">@L["Number"]</span><span class="value">@BigNumber.ToString("N2")</span></div>
        <div class="row">
            <span class="label">@L["Direction"]</span>
            <span class="value">@(Language.IsRightToLeft ? L["DirectionRtl"] : L["DirectionLtr"])</span>
        </div>
        <p class="note">@L["ItemsInCart", 3]</p>
    </div>

    <div class="card">
        <h2 class="card-title">@L["MixedTitle"]</h2>
        <p class="sample">@L["MixedSample"]</p>
    </div>
</div>

@code {
    // Fixed values so every language shows the same data.
    private static readonly DateTime Today = new(2026, 3, 14);
    private const decimal Price = 1234.5m;
    private const double BigNumber = 9876543.21;
}
