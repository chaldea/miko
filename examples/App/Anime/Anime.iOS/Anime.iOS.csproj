<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Select the iOS 27 SDK for Xcode 27; net10.0-ios defaults to the iOS 26 SDK. -->
    <TargetFramework>net10.0-ios27.0</TargetFramework>
    <!-- The installed Xcode 27 bindings are preview APIs and require explicit opt-in. -->
    <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.miko.anime</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- mlaunch receives a project-relative app path, even when run from another directory. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anime\Anime.csproj" />
    <ProjectReference Include="..\..\..\..\src\Miko.iOS\Miko.iOS.csproj" />
  </ItemGroup>

</Project>
