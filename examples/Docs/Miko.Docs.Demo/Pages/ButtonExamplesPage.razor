@page "/button"

<IonPage>
    @if (State.Scene == ButtonDemoScene.Toolbar)
    {
        <IonHeader>
            <ConfigProvider IonicTheme="@ToolbarTheme">
                <IonToolbar>
                <Start>
                    <IonButtons><IonButton OnClick='() => Activate("Cancel")'>Cancel</IonButton></IonButtons>
                </Start>
                <ChildContent><IonTitle>Edit profile</IonTitle></ChildContent>
                <End>
                    <IonButtons><IonButton Strong="true" OnClick='() => Activate("Save")'>Save</IonButton></IonButtons>
                </End>
                </IonToolbar>
            </ConfigProvider>
        </IonHeader>
        <IonContent Class="toolbar-scene-content">
            <div class="scene-explainer">
                <span class="scene-kicker">CONTEXT 02 · TOOLBAR</span>
                <h2>Same button.<br />Different job.</h2>
                <p>Inside a toolbar, IonButton adopts compact dimensions and a clear fill so it belongs beside the title.</p>
                <div class="context-facts">
                    <div><span>Fill</span><strong>Clear by context</strong></div>
                    <div><span>Metrics</span><strong>Compact</strong></div>
                    <div><span>Toolbar color</span><strong>@State.ToolbarColor</strong></div>
                    <div><span>Design mode</span><strong>@ModeLabel</strong></div>
                </div>
                <div class="scene-action-hint">Try Cancel or Save, then check the interaction output below.</div>
            </div>
        </IonContent>
    }
    else if (State.Scene == ButtonDemoScene.Icons)
    {
        <IonContent Class="icons-scene-content">
            <div class="icons-stage">
                <span class="scene-kicker">CONTEXT 03 · ICONS</span>
                <h2>Icon + label<br />or just an icon.</h2>
                <p>Each slot changes the button's layout without changing its interaction model.</p>
                <div class="icon-example-list">
                    <div class="icon-example">
                        <IonButton Color="@State.Color" OnClick='() => Activate("Start icon")'>
                            <Start><IonIcon Icon="@Ionicons.Star" /></Start>
                            <ChildContent>Favorite</ChildContent>
                        </IonButton>
                        <span class="icon-example-label">START</span>
                    </div>
                    <div class="icon-example">
                        <IonButton Color="@State.Color" OnClick='() => Activate("End icon")'>
                            <End><IonIcon Icon="@Ionicons.Heart" /></End>
                            <ChildContent>Like</ChildContent>
                        </IonButton>
                        <span class="icon-example-label">END</span>
                    </div>
                    <div class="icon-example">
                        <IonButton Color="@State.Color" aria-label="Add favorite" OnClick='() => Activate("Icon only")'>
                            <IconOnly><IonIcon Icon="@Ionicons.Heart" /></IconOnly>
                        </IonButton>
                        <span class="icon-example-label">ICON ONLY</span>
                    </div>
                </div>
                <div class="icons-current-color">Current color · <strong>@State.Color</strong></div>
            </div>
        </IonContent>
    }
    else
    {
        <IonContent Class="button-playground">
            <div class="component-stage">
                <span class="component-stage-label">LIVE COMPONENT</span>
                <div class="@ButtonContainerClass">
                    @if (State.Icon == null)
                    {
                        <IonButton Color="@State.Color" Fill="@State.Fill" Size="@State.Size" Shape="@State.ShapeValue"
                                   Expand="@State.ExpandValue" Strong="@State.Strong" Disabled="@State.Disabled"
                                   aria-label="Interactive button" OnClick="ActivateMain">
                            <ChildContent>@ButtonLabel</ChildContent>
                        </IonButton>
                    }
                    else if (State.IconPosition == ButtonIconPosition.Start)
                    {
                        <IonButton Color="@State.Color" Fill="@State.Fill" Size="@State.Size" Shape="@State.ShapeValue"
                                   Expand="@State.ExpandValue" Strong="@State.Strong" Disabled="@State.Disabled"
                                   aria-label="Interactive button" OnClick="ActivateMain">
                            <Start><IonIcon Icon="@CurrentIcon" /></Start>
                            <ChildContent>@ButtonLabel</ChildContent>
                        </IonButton>
                    }
                    else if (State.IconPosition == ButtonIconPosition.End)
                    {
                        <IonButton Color="@State.Color" Fill="@State.Fill" Size="@State.Size" Shape="@State.ShapeValue"
                                   Expand="@State.ExpandValue" Strong="@State.Strong" Disabled="@State.Disabled"
                                   aria-label="Interactive button" OnClick="ActivateMain">
                            <End><IonIcon Icon="@CurrentIcon" /></End>
                            <ChildContent>@ButtonLabel</ChildContent>
                        </IonButton>
                    }
                    else
                    {
                        <IonButton Color="@State.Color" Fill="@State.Fill" Size="@State.Size" Shape="@State.ShapeValue"
                                   Expand="@State.ExpandValue" Strong="@State.Strong" Disabled="@State.Disabled"
                                   aria-label="Interactive button" OnClick="ActivateMain">
                            <IconOnly><IonIcon Icon="@CurrentIcon" /></IconOnly>
                        </IonButton>
                    }
                </div>
                <div class="component-summary">@State.Color <span>·</span> @State.Fill <span>·</span> @State.Size</div>
                <div class="component-state">@(State.Disabled ? "Interaction is disabled" : "Click the button and watch the output below")</div>
                <div class="component-mode"><span></span>@($"{ModeLabel} preview")</div>
            </div>
        </IonContent>
    }
</IonPage>

@code {
    [Inject] public ButtonPlaygroundState State { get; set; } = null!;
    [Inject] public PlatformInfo Platform { get; set; } = null!;

    private string ModeLabel => Platform.Platform == HostPlatform.Ios ? "iOS" : "Material";
    private string ButtonLabel => State.ClickCount == 0 ? "Tap me" : $"Tapped {State.ClickCount} times";
    private string CurrentIcon => State.Icon == "star" ? Ionicons.Star : Ionicons.Heart;
    private string ButtonContainerClass => $"component-button-wrap {State.Expand ?? "inline"}";
    private Miko.Common.Color ToolbarBackground => State.ToolbarColor switch
    {
        "primary" => Miko.Common.Color.FromHex("#512bd4"),
        "dark" => Miko.Common.Color.FromHex("#222428"),
        _ => Miko.Common.Color.FromHex("#ffffff"),
    };
    private Miko.Common.Color ToolbarText => State.ToolbarColor == "light"
        ? Miko.Common.Color.FromHex("#202941")
        : Miko.Common.Color.FromHex("#ffffff");
    private IonicTheme ToolbarTheme => new()
    {
        Toolbar = new ToolbarToken
        {
            Background = ToolbarBackground,
            Color = ToolbarText,
            BorderColor = ToolbarBackground,
        },
    };

    private void ActivateMain()
    {
        State.Click("IonButton");
    }

    private void Activate(string source)
    {
        State.Click(source);
    }
}
