<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      不再固定 RuntimeIdentifier：系统原生视频后端使用各平台自带的解码栈，
      不需要绑定 FFmpeg 的 win-x64 原生运行时，因此本示例可在三个桌面平台构建。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikoApp.Media\MikoApp.Media.csproj" />
    <ProjectReference Include="..\..\..\src\Miko.Windowing\Miko.Windowing.csproj" />
  </ItemGroup>

</Project>
