@page "/"
@namespace MikoApp.Media.Pages
@inject HttpClient Http

<!--
    两路视频并列，都由系统原生硬件解码器解码（桌面 Media Foundation / GStreamer /
    AVFoundation，移动端 MediaCodec / AVPlayer），不依赖 FFmpeg。
-->
<div class="video-row">
    <div class="video-cell">
        <div class="video-label">网络视频（http）</div>
        <!-- 需先启动 MikoApp.Media.Api；经 http 边下边解。 -->
        <video class="hero"
               src="http://localhost:5050/assets/sample.mp4"
               autoplay loop muted />
    </div>

    <div class="video-cell">
        <div class="video-label">本地视频（文件）</div>
        <!-- 裸路径 → MediaSourceScheme.File，随输出目录复制，无需 API 即可播放。 -->
        <video class="hero"
               src="Assets/miko-local.mp4"
               autoplay loop muted />
    </div>
</div>

@if (_isLoading)
{
    <div class="loading">Loading products…</div>
}
else if (_products is { Count: > 0 })
{
    <div class="grid">
        @foreach (var p in _products)
        {
            <div class="card">
                <!-- 网络缩略图：加载完成前显示嵌入资源占位图（res://）。 -->
                <img class="thumb" src="@p.ThumbnailUrl" placeholder="res://Assets/spinner.png" />
                <div class="card-name">@p.Name</div>
                <div class="card-price">$@p.Price · @p.Category</div>
            </div>
        }
    </div>
}
else
{
    <div class="loading">No products found.</div>
}

@code {
    private List<Product>? _products;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await Http.GetFromJsonAsync<List<Product>>("/api/products");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
            _products = new List<Product>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    record Product(int Id, string Name, decimal Price, string Category, string ThumbnailUrl);
}
