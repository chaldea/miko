<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>Latest</RazorLangVersion>
    <StartupObject>MikoAppBlank.Program</StartupObject>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!--
      Miko renders with SkiaSharp, not the browser, so the Razor SDK's web-asset
      pipeline is not used. Turn it off to avoid pulling in static web asset
      processing from transitive ASP.NET Core dependencies.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Miko\Miko.csproj" />
    <ProjectReference Include="..\..\..\src\Miko.DevTools\Miko.DevTools.csproj" />
    <ProjectReference Include="..\..\..\src\Miko.Ionic\Miko.Ionic.csproj" />
    <ProjectReference Include="..\..\..\src\Miko.Windowing\Miko.Windowing.csproj" />
  </ItemGroup>

</Project>