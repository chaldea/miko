<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The webcam demo shared by the Desktop / Android / iOS heads. Each head adds its video backend
       and native services and drives the render loop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>Latest</RazorLangVersion>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Miko.Components/Miko.Components.csproj" />
  </ItemGroup>
</Project>
