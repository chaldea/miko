<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MikoApp.Player/MikoApp.Player.csproj" />
    <ProjectReference Include="../../../src/Miko.Windowing/Miko.Windowing.csproj" />
    <!-- Copied next to the app: the system decoders need a file, and App.BundledClip resolves against
         the app's directory. -->
    <Content Include="../../Media/MikoApp.Media/Assets/miko-local.mp4" Link="Assets/miko-local.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
