<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>VectorSharpnessProbe.Program</StartupObject>
    <!-- 诊断示例，不参与打包。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Miko.Windowing\Miko.Windowing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测矢量图：圆形，边缘特征单一，便于逐像素判读。
         两种 viewBox 尺寸用于区分"源分辨率"与"绘制尺寸"两个变量。 -->
    <EmbeddedResource Include="Assets\probe-circle.svg" />
    <EmbeddedResource Include="Assets\probe-circle-512.svg" />
  </ItemGroup>

</Project>
