<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Follow SDK defaults: AOT is opt-in, while Release publishing can relink
         the runtime when wasm-tools is installed. Do not force WasmBuildNative=false. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
    <ProjectReference Include="../Miko.Docs.Demo/Miko.Docs.Demo.csproj" />
  </ItemGroup>
</Project>
