<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The reserved demo uses the interpreter; no AOT/native workload is needed. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
    <!-- Keep the prebuilt runtime's globalization configuration. With wasm-tools
         installed, InvariantGlobalization=true requires native relinking. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
    <ProjectReference Include="../Miko.Docs.Demo/Miko.Docs.Demo.csproj" />
  </ItemGroup>
</Project>
