@* Edge pulls the button up by half its height so it straddles the header line. *@
<IonPage>
    <IonHeader>
        <IonToolbar>
            <IonTitle>Inbox</IonTitle>
        </IonToolbar>
    </IonHeader>
    <IonContent>
        <Fixed>
            <IonFab Vertical="top" Horizontal="end" Edge="true">
                <IonFabButton>
                    <IonIcon Icon="@Ionicons.Pencil" />
                </IonFabButton>
            </IonFab>
        </Fixed>
    </IonContent>
</IonPage>
