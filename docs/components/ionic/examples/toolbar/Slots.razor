@* With a named slot in use, the title goes in <ChildContent>. *@
<IonToolbar>
    <Start>
        <IonBackButton DefaultHref="/" />
    </Start>
    <ChildContent>
        <IonTitle>Details</IonTitle>
    </ChildContent>
    <End>
        <IonButtons>
            <IonButton>
                <IconOnly>
                    <IonIcon Icon="@Ionicons.Share" />
                </IconOnly>
            </IonButton>
        </IonButtons>
    </End>
</IonToolbar>
