@* Put ion-padding on a wrapper inside IonContent: on IonContent itself it has no effect. *@
<IonPage>
    <IonContent>
        <div class="ion-padding">
            <h2>Welcome</h2>
            <p>Content placed in the wrapper is inset by 16px on every side.</p>
        </div>
    </IonContent>
</IonPage>
