<IonList>
    @* Default: the divider starts after the Start slot and the leading padding. *@
    <IonItem>
        <Start>
            <IonIcon Icon="@Ionicons.Star" />
        </Start>
        <ChildContent>
            <IonLabel>Default</IonLabel>
        </ChildContent>
    </IonItem>
    <IonItem Lines="full">
        <Start>
            <IonIcon Icon="@Ionicons.Star" />
        </Start>
        <ChildContent>
            <IonLabel>Full</IonLabel>
        </ChildContent>
    </IonItem>
    <IonItem Lines="none">
        <Start>
            <IonIcon Icon="@Ionicons.Star" />
        </Start>
        <ChildContent>
            <IonLabel>None</IonLabel>
        </ChildContent>
    </IonItem>
</IonList>
