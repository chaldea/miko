<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Miko.Components</PackageId>
    <Authors>Miko</Authors>
    <Description>Native text editor, map, player, camera, scanner, webcam, VNC and book/comic reader components for Miko.</Description>
    <PackageTags>miko;components;editor;diff;map;amap;player;video;camera;qrcode;scanner;webcam;rtsp;ezviz;vnc;rfb;remote-desktop;reader;epub;pdf;cbz;cbr;ui</PackageTags>
    <PackageProjectUrl>https://github.com/chaldea/miko</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chaldea/miko</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Miko.Components.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Miko/Miko.csproj" />
    <!-- Barcode decoding for MikoBarcodeScanner: a managed port of ZXing (Apache-2.0), no native code. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- Readers: RAR decoding (MIT), PDF page rasterization (Apache-2.0), inert EPUB HTML parsing (MIT). -->
    <PackageReference Include="SharpCompress" Version="0.50.9" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.16.8" />
    <PackageReference Include="AngleSharp" Version="1.10.4" />
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/arrow-back-outline.svg;../Miko.Ionic/Resources/svg/list-outline.svg;../Miko.Ionic/Resources/svg/sunny-outline.svg;../Miko.Ionic/Resources/svg/moon-outline.svg;../Miko.Ionic/Resources/svg/options-outline.svg;../Miko.Ionic/Resources/svg/chevron-forward-outline.svg;../Miko.Ionic/Resources/svg/book-outline.svg">
      <LogicalName>Miko.Reader.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/chevron-back-outline.svg;../Miko.Ionic/Resources/svg/close-outline.svg;../Miko.Ionic/Resources/svg/flash-outline.svg;../Miko.Ionic/Resources/svg/flash-off-outline.svg;../Miko.Ionic/Resources/svg/camera-reverse-outline.svg;../Miko.Ionic/Resources/svg/images.svg;../Miko.Ionic/Resources/svg/flashlight.svg">
      <Link>Camera/Icons/%(Filename)%(Extension)</Link>
      <LogicalName>Miko.Camera.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/play.svg;../Miko.Ionic/Resources/svg/pause.svg;../Miko.Ionic/Resources/svg/volume-high.svg;../Miko.Ionic/Resources/svg/volume-mute.svg;../Miko.Ionic/Resources/svg/settings-outline.svg;../Miko.Ionic/Resources/svg/expand.svg;../Miko.Ionic/Resources/svg/contract.svg;../Miko.Ionic/Resources/svg/chatbox-outline.svg;../Miko.Ionic/Resources/svg/refresh.svg">
      <Link>Player/Icons/%(Filename)%(Extension)</Link>
      <LogicalName>Miko.Player.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/stop.svg;../Miko.Ionic/Resources/svg/camera-outline.svg;../Miko.Ionic/Resources/svg/eye-off-outline.svg;../Miko.Ionic/Resources/svg/swap-vertical-outline.svg;../Miko.Ionic/Resources/svg/alert-circle-outline.svg;../Miko.Ionic/Resources/svg/caret-up.svg;../Miko.Ionic/Resources/svg/caret-down.svg;../Miko.Ionic/Resources/svg/caret-back.svg;../Miko.Ionic/Resources/svg/caret-forward.svg">
      <Link>Webcam/Icons/%(Filename)%(Extension)</Link>
      <LogicalName>Miko.Webcam.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/keypad-outline.svg;../Miko.Ionic/Resources/svg/key-outline.svg;../Miko.Ionic/Resources/svg/add-outline.svg;../Miko.Ionic/Resources/svg/remove-outline.svg;../Miko.Ionic/Resources/svg/power-outline.svg;../Miko.Ionic/Resources/svg/chevron-up-outline.svg;../Miko.Ionic/Resources/svg/chevron-down-outline.svg;../Miko.Ionic/Resources/svg/lock-closed-outline.svg;../Miko.Ionic/Resources/svg/desktop-outline.svg">
      <Link>Vnc/Icons/%(Filename)%(Extension)</Link>
      <LogicalName>Miko.Vnc.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
