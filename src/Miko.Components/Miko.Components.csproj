<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Miko.Components</PackageId>
    <Version>1.0.0</Version>
    <Authors>Miko</Authors>
    <Description>Native player components for Miko.</Description>
    <PackageTags>miko;components;player;video;ui</PackageTags>
    <PackageProjectUrl>https://github.com/chaldea/miko</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chaldea/miko</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Miko/Miko.csproj" />
    <EmbeddedResource Include="../Miko.Ionic/Resources/svg/play.svg;../Miko.Ionic/Resources/svg/pause.svg;../Miko.Ionic/Resources/svg/volume-high.svg;../Miko.Ionic/Resources/svg/volume-mute.svg;../Miko.Ionic/Resources/svg/settings-outline.svg;../Miko.Ionic/Resources/svg/expand.svg;../Miko.Ionic/Resources/svg/contract.svg;../Miko.Ionic/Resources/svg/chatbox-outline.svg;../Miko.Ionic/Resources/svg/refresh.svg">
      <Link>Player/Icons/%(Filename)%(Extension)</Link>
      <LogicalName>Miko.Player.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
