<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Minimum Android version: 8.0 (API 26). Notification channels, VibrationEffect and the
         network-callback APIs used by Miko.Native exist there unconditionally; newer APIs are
         behind OperatingSystem.IsAndroidVersionAtLeast checks. Apps, templates and examples
         declare the same minimum (ISSUE-154). -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <!-- A call to an API newer than the minimum must sit behind a version check. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Miko.Android</PackageId>
    <Authors>Miko</Authors>
    <Description>Android host (SkiaSharp GL surface + touch input) for the Miko rendering engine.</Description>
    <PackageTags>miko;android;skiasharp;ui</PackageTags>
    <PackageProjectUrl>https://github.com/chaldea/miko</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chaldea/miko</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miko\Miko.csproj" />
    <ProjectReference Include="..\Miko.Native\Miko.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views" Version="3.119.1" />
  </ItemGroup>

</Project>
