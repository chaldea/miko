<Project>

  <!--
    When this NuGet package is referenced, replace the default Razor source generator
    with the bundled Miko.Razor.Compiler one. The DLLs live in `tools/<tool TFM>/` inside
    the package; `$(MSBuildThisFileDirectory)` resolves to `<package>/build/` at restore
    time, so we walk up one level to reach `tools/`.

    The folder is named after the compiler's OWN target framework, never the consuming
    project's `$(TargetFramework)`: a platform project (`net10.0-android`, `net10.0-ios`,
    `net10.0-windows`) that contains `.razor` files would otherwise look for a
    `tools/net10.0-android/` folder that does not exist and silently lose the generator
    (ISSUE-154). The compiler runs inside the build, not on the device, so one build serves
    every consumer TFM. Miko.Razor.Compiler.csproj checks at pack time that this value
    matches its TargetFramework.
  -->
  <PropertyGroup>
    <_MikoRazorCompilerToolFramework>net10.0</_MikoRazorCompilerToolFramework>
  </PropertyGroup>

  <Target Name="_OverrideRazorSourceGenerator" AfterTargets="_PrepareRazorSourceGenerators">
    <PropertyGroup>
      <_CustomRazorGeneratorDir>$(MSBuildThisFileDirectory)..\tools\$(_MikoRazorCompilerToolFramework)\</_CustomRazorGeneratorDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CustomRazorGeneratorDir)Microsoft.CodeAnalysis.Razor.Compiler.dll')"
           Text="Miko.Razor.Compiler: the Razor compiler was not found in '$(_CustomRazorGeneratorDir)'. The package is incomplete; restore it again." />
    <ItemGroup>
      <Analyzer Remove="@(_RazorAnalyzer)" />
      <_RazorAnalyzer Remove="@(_RazorAnalyzer)" />
    </ItemGroup>
    <ItemGroup>
      <_RazorAnalyzer Include="$(_CustomRazorGeneratorDir)Microsoft.CodeAnalysis.Razor.Compiler.dll" />
      <_RazorAnalyzer Include="$(_CustomRazorGeneratorDir)Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
      <_RazorAnalyzer Include="$(_CustomRazorGeneratorDir)Microsoft.Extensions.ObjectPool.dll" />
      <Analyzer Include="@(_RazorAnalyzer)" />
    </ItemGroup>
  </Target>

</Project>
