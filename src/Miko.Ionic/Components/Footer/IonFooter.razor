@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<div class="@ClassMapper.Class" style="@Style">
    @if (Translucent && Mode == "ios")
    {
        <div class="footer-background"></div>
    }
    @ChildContent
</div>

@code {
    /// <summary>
    /// Ionic's <c>translucent</c>. Has an effect only in iOS mode, and only a partial one: there
    /// is no backdrop blur and content does not scroll behind the footer — the toolbars inside are
    /// drawn at 80% opacity. Stamps <c>footer-translucent</c> / <c>footer-translucent-{mode}</c>.
    /// </summary>
    [Parameter] public bool Translucent { get; set; }

    [CascadingParameter] internal IonTabs? Tabs { get; set; }

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-footer")
            .Add($"footer-{Mode}")
            .If(Translucent, "footer-translucent")
            .If(Translucent, $"footer-translucent-{Mode}")
            // footer.tsx: the tab bar pads for the safe area instead (keyboard visibility is not tracked).
            .If(Tabs?.Bottom is null, "footer-toolbar-padding");
    }
}
