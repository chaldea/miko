@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<CascadingValue TValue="IonListHeaderContext" Value="@IonListHeaderContext.Instance">
    <div class="@ClassMapper.Class" style="@Style">
        <div class="list-header-inner">
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>How the bottom border is displayed (Ionic <c>lines</c>):
    /// <c>"full"</c>, <c>"inset"</c>, or <c>"none"</c>.</summary>
    [Parameter] public string? Lines { get; set; }

    /// <summary>Named palette color (Ionic <c>color</c>): <c>"primary"</c>,
    /// <c>"danger"</c>, etc.</summary>
    [Parameter] public string? Color { get; set; }

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-list-header")
            .AddValue(Lines, "list-header-lines-")
            .If(!string.IsNullOrWhiteSpace(Color), "ion-color")
            .AddColor(Color);
    }
}
