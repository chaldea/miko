@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@using Miko.Platform
@* Mirrors Ionic's <ion-back-button> structure:
   <ion-back-button>                    <!-- host with show-back-button / disabled classes -->
     <button class="button-native">     <!-- clickable surface with flex layout -->
       <span class="button-inner">      <!-- centers the icon + text row -->
         <ion-icon part="icon"></ion-icon>
         <span part="text" class="button-text"></span>
       </span>
     </button>
   </ion-back-button>
   The icon defaults to chevron-left (iOS) / arrow-left (MD). The text defaults to "Back" on
   iOS, null on MD. When the button has icon-only (no text), it uses a circular ripple effect. *@
<div class="@ClassMapper.Class" style="@Style">
    <button class="button-native" @onclick="HandleClick" disabled="@Disabled">
        <span class="button-inner">
            @if (_icon != null)
            {
                <IonIcon Icon="@_icon" Class="back-button-icon" />
            }
            @if (_text != null)
            {
                <span class="button-text">@_text</span>
            }
        </span>
    </button>
</div>

@code {
    /// <summary>Named palette color (Ionic <c>color</c>): <c>"primary"</c>, <c>"danger"</c>, … .
    /// Colors the button's text and icon.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>The path to navigate back to when the history stack cannot go back. The button is
    /// shown when this is set or when there is history to go back to (Ionic's
    /// <c>.can-go-back</c>); with neither it is hidden.</summary>
    [Parameter] public string? DefaultHref { get; set; }

    /// <summary>When true, the user cannot interact with the button (dimmed, non-interactive).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Override the default back button icon (an <c>Ionicons</c> name). When null, uses the
    /// mode default: <c>chevron-back</c> on iOS, <c>arrow-back-sharp</c> on MD.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Override the default back button text. When null, uses the mode default
    /// ("Back" for iOS, null for MD).</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Raised when the button is clicked (skipped when disabled). The default
    /// behavior still runs afterwards: nav-pop (with the mode's back transition) when the
    /// nav stack can go back, else a back-direction navigation to <see cref="DefaultHref"/>.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>
    /// Whether the system back button (hardware back / back gesture / Escape) navigation-pops the
    /// same way a tap on this button does. Defaults to <c>true</c>. Set to <c>false</c> when the
    /// page wants hardware back to behave differently from tapping the on-screen button
    /// (ISSUE-138).
    /// </summary>
    [Parameter] public bool RespondToHardwareBack { get; set; } = true;

    private string? _icon;
    private string? _text;

    protected override void OnParametersSet()
    {
        // Resolve the icon — either the explicit Icon parameter, or the mode default.
        _icon = Icon ?? (Mode == "ios" ? "chevron-back" : "arrow-back-sharp");

        // Resolve the text — either the explicit Text parameter, or the mode default.
        _text = Text ?? (Mode == "ios" ? "Back" : null);

        // Build the CSS class. Ionic shows the button when defaultHref is set (showBackButton) and,
        // through core.scss `.can-go-back > ion-header ion-back-button`, on any page that has
        // history to go back to — without DefaultHref it used to stay hidden even then (ISSUE-153).
        // The page is rebuilt on navigation, so CanGoBack is current here.
        var showButton = DefaultHref != null || Navigation?.CanGoBack == true;
        var hasIconOnly = _icon != null && _text == null;

        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-back-button")
            .Add("button")
            .If(showButton, "show-back-button")
            .If(Disabled, "back-button-disabled")
            .If(hasIconOnly, "back-button-has-icon-only")
            .AddColor(Color);

        // Only claim the system back button while the button itself is actually usable — a hidden
        // (no DefaultHref) or disabled back button must not swallow the platform's back action.
        // Navigation has the lowest priority, so any open overlay or menu answers back first.
        RegisterBackHandler(RespondToHardwareBack && showButton && !Disabled ? HandleHardwareBack : null,
            BackButtonPriority.Navigation);
    }

    private async Task HandleClick(MouseEventArgs _)
    {
        if (Disabled) return;
        await OnClick.InvokeAsync();
        NavigateBack();
    }

    private bool HandleHardwareBack() => !Disabled && RespondToHardwareBack && NavigateBack();

    /// <summary>
    /// The navigation shared by a tap and the system back button: pop the nav stack when it can
    /// go back (with the mode's pop transition); otherwise fall back to <see cref="DefaultHref"/>
    /// with a back-direction navigation. Returns whether it actually navigated — that is the
    /// honest answer to "was the back action consumed": with no <c>Navigation</c> (bare
    /// tests), or when <see cref="DefaultHref"/> is already the current page, nothing happens and
    /// the platform default (exit) must run instead of a silently swallowed press.
    /// </summary>
    private bool NavigateBack()
    {
        if (Navigation is null) return false;

        var pop = IonicPageTransitions.Pop(Mode);
        if (Navigation.NavigateBack(pop)) return true;
        if (DefaultHref is null || DefaultHref == Navigation.CurrentPath) return false;

        Navigation.NavigateTo(DefaultHref, NavigationDirection.Back, pop);
        return true;
    }
}
