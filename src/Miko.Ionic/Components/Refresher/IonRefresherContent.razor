@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<div class="@ClassMapper.Class" style="@Style">
    <div class="refresher-pulling">
        @if (!string.IsNullOrEmpty(_pullingIcon))
        {
            <div class="refresher-pulling-icon">
                <IonIcon Icon="@_pullingIcon" />
            </div>
        }
        @if (PullingText is not null)
        {
            <div class="refresher-pulling-text">@PullingText</div>
        }
    </div>
    <div class="refresher-refreshing">
        @if (!string.IsNullOrEmpty(_refreshingSpinner))
        {
            <div class="refresher-refreshing-icon">
                <IonSpinner Name="@_refreshingSpinner" />
            </div>
        }
        @if (RefreshingText is not null)
        {
            <div class="refresher-refreshing-text">@RefreshingText</div>
        }
    </div>
</div>

@code {
    /// <summary>Icon to show while pulling. Defaults to arrow-down (md) / refresh (ios).</summary>
    [Parameter] public string? PullingIcon { get; set; }

    /// <summary>Text to show while pulling.</summary>
    [Parameter] public string? PullingText { get; set; }

    /// <summary>Spinner name (an <see cref="IonSpinner"/> <c>Name</c>) to show while refreshing.
    /// Defaults to <c>"circular"</c> (md) / <c>"lines"</c> (ios).</summary>
    [Parameter] public string? RefreshingSpinner { get; set; }

    /// <summary>Text to show while refreshing.</summary>
    [Parameter] public string? RefreshingText { get; set; }

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-refresher-content");

        // Resolved per render rather than written back into the parameters: the instance outlives
        // parent re-renders (ISSUE-154), and a written-back default would pass for a value the parent
        // supplied.
        _pullingIcon = PullingIcon ?? (Mode == "ios" ? Ionicons.Refresh : Ionicons.ArrowDown);
        _refreshingSpinner = RefreshingSpinner ?? (Mode == "ios" ? "lines" : "circular");
    }

    private string? _pullingIcon;
    private string? _refreshingSpinner;
}
