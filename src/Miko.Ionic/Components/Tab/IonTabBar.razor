@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<div class="@ClassMapper.Class" style="@Style">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Ionic's <c>slot</c> attribute on <c>ion-tab-bar</c>: <c>"bottom"</c> (default) or
    /// <c>"top"</c>, stamped as <c>ion-tab-bar-bottom</c> / <c>ion-tab-bar-top</c>. It picks the
    /// border side and the safe-area inset the bar pads for (a bottom bar: top border, bottom
    /// inset; a top bar: bottom border, top inset); the <see cref="IonTabs"/> slot the bar is
    /// placed in (<c>Bottom</c> / <c>Top</c>) decides the position.
    /// </summary>
    [Parameter] public string Slot { get; set; } = "bottom";

    protected override void OnParametersSet()
    {
        var slot = string.Equals(Slot, "top", StringComparison.OrdinalIgnoreCase) ? "top" : "bottom";

        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-tab-bar")
            .Add($"ion-tab-bar-{slot}");
    }
}
