@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<a class="@ClassMapper.Class" style="@Style" href="@Href" @onclick="HandleClick">
    @ChildContent
</a>

@code {
    /// <summary>Navigation target for the tab button. When the button sits inside an
    /// <see cref="IonTabs"/>, clicking it performs a root-level navigation to this target
    /// (history cleared, no page transition), mirroring Ionic's tab switching. Outside an
    /// <see cref="IonTabs"/> the button does not navigate.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Whether this tab button is the currently selected one (stamps <c>tab-selected</c>).
    /// Not derived from the route — the app sets it, e.g. by comparing
    /// <c>NavigationManager.CurrentPath</c> with <see cref="Href"/>.</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Invoked when the tab button is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>The owning <see cref="IonTabs"/>, cascaded from its top or bottom slot. Tab
    /// navigation is owned by IonTabs (root-level, no transition) — the button reports clicks
    /// to it after raising <see cref="OnClick"/>.</summary>
    [CascadingParameter] public IonTabs? Tabs { get; set; }

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-tab-button")
            .If(Selected, "tab-selected");
    }

    private async Task HandleClick(MouseEventArgs _)
    {
        await OnClick.InvokeAsync();
        Tabs?.SelectTab(this);
    }
}
