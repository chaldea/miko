@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@using Miko.Animation
@using Miko.Common
@* Mirrors Ionic's <ion-progress-bar> host structure:
   <ion-progress-bar class="{mode} ion-progress-bar progress-bar-{determinate|indeterminate} ...">
     determinate:
       <div class="progress" style="width: value%" />                <!-- the value fill -->
       <div class="buffer-circles-container">
         <div class="buffer-circles-container"><div class="buffer-circles" /></div>
       </div>
       <div class="progress-buffer-bar" style="width: buffer%" />   <!-- the background track -->
     indeterminate:
       <div class="progress-buffer-bar">
         <div class="indeterminate-bar-primary"><span class="progress-indeterminate" /></div>
         <div class="indeterminate-bar-secondary"><span class="progress-indeterminate" /></div>
       </div>
   Ionic scales the fill with `transform: scaleX(value)`; Miko has no `scaleX(var)` in a static
   stylesheet, so the fill/buffer width is bound as an inline Length.Percent computed in @code. *@
<div class="@ClassMapper.Class">
    @if (IsIndeterminate)
    {
        <div class="progress-buffer-bar">
            <div class="indeterminate-bar-primary" style="@_primaryTranslateStyle">
                <span class="progress-indeterminate" style="@_primaryScaleStyle"></span>
            </div>
            <div class="indeterminate-bar-secondary" style="@_secondaryTranslateStyle">
                <span class="progress-indeterminate" style="@_secondaryScaleStyle"></span>
            </div>
        </div>
    }
    else
    {
        <div class="progress" style="@_progressStyle"></div>
        <div class="@_bufferCirclesContainerClass" style="@_bufferCirclesOuterStyle">
            <div class="buffer-circles-container" style="@_bufferCirclesInnerStyle">
                <div class="buffer-circles" style="@_bufferCirclesStyle"></div>
            </div>
        </div>
        <div class="progress-buffer-bar" style="@_bufferStyle"></div>
    }
</div>

@code {
    /// <summary>Named palette color (Ionic <c>color</c>): <c>"primary"</c>, <c>"danger"</c>, … .
    /// Stamped as an <c>ion-color-*</c> class the stylesheet maps to the fill / track color.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Bar state: <c>"determinate"</c> (default, shows <see cref="Value"/>) or
    /// <c>"indeterminate"</c> (an animated left-to-right stripe).</summary>
    [Parameter] public string Type { get; set; } = "determinate";

    /// <summary>How much of the active fill shows when determinate. Clamped to [0, 1] (default 0).</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>Buffer amount. Clamped to [0, 1] (default 1). When &lt; 1 the buffer track shows.</summary>
    [Parameter] public double Buffer { get; set; } = 1;

    /// <summary>If true, reverse the progress bar direction.</summary>
    [Parameter] public bool Reversed { get; set; }

    private Style? _progressStyle;
    private Style? _bufferStyle;
    private Style? _bufferCirclesOuterStyle;
    private Style? _bufferCirclesInnerStyle;
    private Style? _bufferCirclesStyle;
    private string _bufferCirclesContainerClass = "buffer-circles-container ion-hide";
    private Style? _primaryTranslateStyle;
    private Style? _primaryScaleStyle;
    private Style? _secondaryTranslateStyle;
    private Style? _secondaryScaleStyle;

    private bool IsIndeterminate => string.Equals(Type, "indeterminate", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        var type = NormalizeToken(Type, "determinate");
        var buffer = Clamp01(Buffer);
        // A solid bar still renders its full-width track; the class selects Ionic's iOS treatment.
        var progressSolid = buffer >= 1d;

        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-progress-bar")
            .Add($"progress-bar-{type}")
            .If(Reversed, "progress-bar-reversed")
            .If(progressSolid, "progress-bar-solid")
            .If(!string.IsNullOrWhiteSpace(Color), "ion-color")
            .AddColor(Color);

        // Determinate: the fill width scales with value; the buffer track width with buffer.
        // (Ionic uses transform: scaleX; we express the same proportion as a percentage width.)
        var value = Clamp01(Value);
        _progressStyle = new Style { Width = Length.Percent((float)(value * 100)) };
        _bufferStyle = new Style { Width = Length.Percent((float)(buffer * 100)) };
        _bufferCirclesContainerClass = progressSolid
            ? "buffer-circles-container ion-hide"
            : "buffer-circles-container";
        _bufferCirclesOuterStyle = new Style
        {
            Transform = TranslateX(Length.Percent((float)(buffer * 100))),
        };
        _bufferCirclesInnerStyle = new Style
        {
            Transform = TranslateX(Length.Percent((float)(buffer * -100))),
        };
        _bufferCirclesStyle = progressSolid
            ? null
            : AnimationStyle(
                "buffering",
                0.45f,
                (0f, TranslateX(Length.Px(0))),
                (1f, TranslateX(Length.Px(-10))));

        if (IsIndeterminate)
        {
            BuildIndeterminateAnimationStyles();
        }
        else
        {
            _primaryTranslateStyle = null;
            _primaryScaleStyle = null;
            _secondaryTranslateStyle = null;
            _secondaryScaleStyle = null;
        }
    }

    private void BuildIndeterminateAnimationStyles()
    {
        _primaryTranslateStyle = AnimationStyle(
            "primary-indeterminate-translate",
            2f,
            (0f, TranslateX(0f)),
            (0.2f, TranslateX(0f)),
            (0.5915f, TranslateX(83.67142f)),
            (1f, TranslateX(200.611057f)));

        _primaryScaleStyle = AnimationStyle(
            "primary-indeterminate-scale",
            2f,
            (0f, ScaleX(0.08f)),
            (0.3665f, ScaleX(0.08f)),
            (0.6915f, ScaleX(0.661479f)),
            (1f, ScaleX(0.08f)));

        _secondaryTranslateStyle = AnimationStyle(
            "secondary-indeterminate-translate",
            2f,
            (0f, TranslateX(0f)),
            (0.25f, TranslateX(37.651913f)),
            (0.4835f, TranslateX(84.386165f)),
            (1f, TranslateX(160.277782f)));

        _secondaryScaleStyle = AnimationStyle(
            "secondary-indeterminate-scale",
            2f,
            (0f, ScaleX(0.08f)),
            (0.1915f, ScaleX(0.457104f)),
            (0.4415f, ScaleX(0.72796f)),
            (1f, ScaleX(0.08f)));
    }

    private static Style AnimationStyle(
        string name,
        float duration,
        params (float Offset, Transform Transform)[] frames)
        => new()
        {
            Animations = new List<KeyframeAnimation>
            {
                new(name, duration, frames.Select(frame =>
                    new Keyframe(frame.Offset, new Style { Transform = frame.Transform })).ToArray())
                {
                    Infinite = true,
                    TimingFunction = TimingFunction.Linear,
                },
            },
        };

    private static Transform TranslateX(float percent)
        => new(new TransformFunction.TranslateX(Length.Percent(percent)));

    private static Transform TranslateX(Length distance)
        => new(new TransformFunction.TranslateX(distance));

    private static Transform ScaleX(float scale)
        => new(new TransformFunction.ScaleX(scale));

    private static double Clamp01(double v) => v < 0d ? 0d : v > 1d ? 1d : v;

    private static string NormalizeToken(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value.ToLowerInvariant();
}
