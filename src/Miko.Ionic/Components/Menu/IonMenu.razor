@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@using Miko.Platform
@* Mirrors Ionic's <ion-menu>: a single full-screen host containing the drawer (.menu-inner)
   and the backdrop as siblings. Host, drawer and backdrop are always laid out, so the slide and
   the fade animate in both directions — a transition needs a previous-frame layout box, and
   both are pure functions of IsOpen. That matters because the host re-renders the page to
   change IsOpen, which builds a new IonMenu instance: a "backdrop still fading" flag kept on
   the instance was lost, so the fade-out never played (ISSUE-153). When closed the host is
   pointer-events:none, so taps pass through to the page while the backdrop fades out; at
   opacity 0 the backdrop is not painted. The drawer always slides over the content (Ionic's
   default "overlay" type); the "reveal" / "push" types, which move the page itself, are not
   ported, so there is no Type parameter. *@
@* Backdrop is authored BEFORE the drawer so the engine's reverse-document-order hit-test
   checks the drawer first: a tap on the drawer hits the drawer, a tap on the dim area falls
   through to the backdrop. (Paint order is handled by z-index via OrderedChildren, so the
   drawer still renders above the backdrop regardless of this source order.) *@
<div class="@_hostClass" style="@Style">
    <div class="@_backdropClass" @onclick="HandleBackdrop"></div>
    <div class="@_innerClass">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Whether the drawer is open (slid on-screen, backdrop dimmed).</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Edge the drawer is anchored to: <c>"start"</c> (default, left) or <c>"end"</c>
    /// (right).</summary>
    [Parameter] public string Side { get; set; } = "start";

    /// <summary>Invoked when the backdrop is tapped, or the system back button is pressed while
    /// the menu is open, asking the host to close the menu (set <see cref="IsOpen"/> to false).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Whether the system back button closes the open menu. Defaults to <c>true</c>; only takes
    /// effect while <see cref="IsOpen"/> and when a host has subscribed to
    /// <see cref="OnClose"/> — with nobody listening there is nothing to close (ISSUE-138).
    /// </summary>
    [Parameter] public bool BackButtonCloses { get; set; } = true;

    private string _hostClass = "md ion-menu-host ion-menu-host-start ion-menu-host-idle";
    private string _innerClass = "ion-menu-inner ion-menu-inner-start";
    private string _backdropClass = "ion-menu-backdrop";

    protected override void OnParametersSet()
    {
        // Claim the system back button only while the drawer is actually open and a host is
        // listening — closing is the host's job (this is a controlled component), so without an
        // OnClose subscriber there is nothing to consume and back should fall through.
        RegisterBackHandler(IsOpen && BackButtonCloses && OnClose.HasDelegate ? HandleBack : null,
            BackButtonPriority.Menu);

        var side = string.Equals(Side, "end", StringComparison.OrdinalIgnoreCase) ? "end" : "start";

        // Host is interactive (auto) while open; pointer-events:none once closed, including while
        // the backdrop fades out.
        var hostState = IsOpen ? "open" : "idle";

        // Build host class with ClassMapper-like pattern but store in field since we have multiple elements
        var hostClassParts = new List<string?> { Class, Mode, "ion-menu-host", $"ion-menu-host-{side}", $"ion-menu-host-{hostState}" };
        _hostClass = string.Join(" ", hostClassParts.Where(c => !string.IsNullOrWhiteSpace(c)));

        _innerClass = IsOpen
            ? $"ion-menu-inner ion-menu-inner-{side} ion-menu-inner-open"
            : $"ion-menu-inner ion-menu-inner-{side}";

        _backdropClass = IsOpen ? "ion-menu-backdrop ion-menu-backdrop-open" : "ion-menu-backdrop";
    }

    protected override void OnDispose()
    {
        // Releases the back-button slot registered in OnParametersSet (base.OnDispose does this,
        // but this override would otherwise shadow it).
        ClearBackHandler();
    }

    private async Task HandleBackdrop(MouseEventArgs _)
    {
        await OnClose.InvokeAsync();
    }

    private bool HandleBack()
    {
        // Same request as a backdrop tap: ask the host to close. The host owns IsOpen, so the
        // slot is released when it re-renders the menu closed.
        if (!IsOpen) return false;
        _ = OnClose.InvokeAsync();
        return true;
    }
}
