@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@* Mirrors Ionic's <ion-avatar>: a circular block (50% radius) sized from the theme's AvatarSize —
   64px in md, 48px in ios. The slotted <img> fills it and is rounded and clipped itself (see
   AvatarStyles); the avatar host does not clip its content. *@
<CascadingValue TValue="MediaContext" Value="@MediaContext.Instance">
    <div class="@ClassMapper.Class" style="@Style">
        @ChildContent
    </div>
</CascadingValue>

@code {
    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-avatar");
    }
}
