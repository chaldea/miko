@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@using Miko.Layout
@* Mirrors Ionic's <ion-picker-column> (picker-column.tsx render()):
   <ion-picker-column class="{mode} ion-picker-column picker-column-disabled? ion-color? ...">
     <slot name="prefix"></slot>          <!-- SlotPrefix -->
     <div class="picker-opts">            <!-- the scrollable wheel -->
       <div class="picker-item-empty"/>   <!-- 3 empty spacer rows (before) -->
       <div class="picker-item-empty"/>
       <div class="picker-item-empty"/>
       <slot></slot>                      <!-- ChildContent: the IonPickerColumnOption children -->
       <div class="picker-item-empty"/>   <!-- 3 empty spacer rows (after) -->
       <div class="picker-item-empty"/>
       <div class="picker-item-empty"/>
     </div>
     <slot name="suffix"></slot>          <!-- SlotSuffix -->
   </ion-picker-column>
   The column owns the single selected Value and cascades it (plus a RequestSelect callback) to its
   options via CascadingValue<IonPickerColumnContext>. Options match the context by type and register
   their metadata into the context's ordered Options list, so the column can map a wheel scroll offset to
   the option under the center. Selection has two paths, mirroring Ionic's setValue + scrollCallback:
   - click (RequestSelect → SelectAsync): sets Value and centers the newly-selected option in the
     scrollable wheel (centerPickerItemInView).
   - scroll (@onscroll on .picker-opts → HandleScroll): the wheel was scrolled (mouse wheel / fling),
     so the nearest enabled option is selected and snapped to the center.
   - finger drag: while a touch pointer is down the wheel follows the finger. The centered option is
     highlighted live but nothing snaps; on release the wheel snaps and ValueChanged fires once — as in
     Ionic, which sets the value only once scrolling settles (ISSUE-149).
   Haptics follow Ionic's scroll listener (ISSUE-149): the first scroll of a gesture starts a
   selection, every change of the centered option ticks, and the selection ends 250ms after the last
   scroll event. Ionic's IntersectionObserver / keyboard logic is runtime DOM behavior with no Miko
   equivalent and remains omitted. *@
<div class="@ClassMapper.Class" style="@Style">
    @if (SlotPrefix is not null)
    {
        <div class="picker-column-prefix">@SlotPrefix</div>
    }
    <div class="picker-opts" @onscroll="HandleScroll">
        <div class="picker-item-empty">&nbsp;</div>
        <div class="picker-item-empty">&nbsp;</div>
        <div class="picker-item-empty">&nbsp;</div>
        <CascadingValue TValue="IonPickerColumnContext" Value="_context">
            @ChildContent
        </CascadingValue>
        <div class="picker-item-empty">&nbsp;</div>
        <div class="picker-item-empty">&nbsp;</div>
        <div class="picker-item-empty">&nbsp;</div>
    </div>
    @if (SlotSuffix is not null)
    {
        <div class="picker-column-suffix">@SlotSuffix</div>
    }
</div>

@code {
    // Wheel geometry — must stay in sync with PickerStyles: 34px option rows, three empty spacer
    // rows padding each end of the list, and a 200px viewport whose center sits at 100px.
    private const float OptionHeight = 34f;
    private const float PickerHeight = 200f;
    private const int LeadingSpacers = 3;

    /// <summary>The column's selected option value. Bind two-way with <see cref="ValueChanged"/>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raised with the new value when an option is tapped or the wheel is scrolled.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>If true, the whole column is dimmed and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Named palette color (Ionic <c>color</c>). Stamped as <c>ion-color-*</c> classes on the
    /// column only; the active-option tint is read from each <see cref="IonPickerColumnOption"/>'s own
    /// <c>Color</c> (primary when unset), so this does not recolor the options.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Content shown on the left of the options (Ionic <c>slot="prefix"</c>).</summary>
    [Parameter] public RenderFragment? SlotPrefix { get; set; }

    /// <summary>Content shown on the right of the options (Ionic <c>slot="suffix"</c>).</summary>
    [Parameter] public RenderFragment? SlotSuffix { get; set; }

    /// <summary>The engine, used to center the wheel on a selected option. Null in bare tests.</summary>
    [Inject] protected MikoEngine? Engine { get; set; }

    private IonPickerColumnContext _context = new();

    // The .picker-opts scroll container, captured in Build() so SelectAsync can center it.
    private Element? _optsElement;

    // Haptic selection session (ISSUE-149). Neither Miko nor the browser raises a scroll-end event,
    // so — like Ionic — the session ends a fixed delay after the last scroll. The end timer runs on
    // the thread pool, hence the lock; haptics are called under it so start/end never reorder.
    private const int SelectionEndDelayMs = 250;
    private readonly object _hapticGate = new();
    private System.Threading.Timer? _selectionEndTimer;
    private bool _hapticSelecting;

    // Touch drag (ISSUE-149). Snapping on every scroll event undid each small finger step, so a slow
    // drag could never leave the selected option; while the finger is down the snap and the binding
    // wait for the release instead. Deferring ValueChanged also keeps a two-way-bound parent from
    // recreating this column (and losing this state) on every tick of the drag.
    private bool _fingerDown;
    private string? _valueAtGestureStart;

    // InitialScrollTop centers the selection when this instance first renders. Every scroll event
    // re-renders the column, and re-applying it then would snap the wheel back under the finger; the
    // engine carries the scroll offset across those re-renders on its own.
    private bool _initialScrollApplied;

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-picker-column")
            .If(Disabled, "picker-column-disabled")
            .If(!string.IsNullOrWhiteSpace(Color), "ion-color")
            .AddColor(Color);

        // Rebuild the cascaded context each render so options read the current Value and a
        // RequestSelect callback bound to this column instance.
        _context = new IonPickerColumnContext
        {
            Value = Value,
            Disabled = Disabled,
            RequestSelect = EventCallback.Factory.Create<string>(this, SelectAsync),
        };
    }

    /// <summary>Captures the scrollable <c>.picker-opts</c> element for <see cref="SelectAsync"/>.</summary>
    public override Element Build()
    {
        var root = base.Build();

        // Raw handlers, not Razor callbacks: tracking the finger must not re-render the column.
        root.OnPointerDown = OnWheelPointerDown;
        root.OnPointerUp = args => _ = ReleaseWheelAsync();
        root.OnPointerCancel = args => _ = ReleaseWheelAsync();

        _optsElement = root.FindByClass("picker-opts").FirstOrDefault();
        if (_optsElement is not null && !_initialScrollApplied)
        {
            var selectedIndex = _context.Options.FindIndex(option => option.Value == Value && !option.Disabled);
            if (selectedIndex >= 0)
            {
                _optsElement.InitialScrollTop = ScrollTopForOption(selectedIndex);
                _initialScrollApplied = true;
            }
        }
        return root;
    }

    private void OnWheelPointerDown(PointerEventArgs args)
    {
        if (Disabled || args.PointerType == PointerType.Mouse) return;
        _fingerDown = true;
        _valueAtGestureStart = Value;
    }

    /// <summary>
    /// The finger left the wheel: snap the centered option into place and report it, once, if the
    /// drag changed it. A fling that follows is handled by <see cref="HandleScroll"/>'s snapping path.
    /// </summary>
    private async Task ReleaseWheelAsync()
    {
        if (!_fingerDown) return;
        _fingerDown = false;

        ScrollActiveIntoView();
        if (Value is { } value && value != _valueAtGestureStart)
        {
            await ValueChanged.InvokeAsync(value);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Invoked by a child option to request becoming the selected one. Mirrors Ionic's
    /// <c>setValue()</c> — no-op when the column is disabled or the value is unchanged; otherwise sets
    /// <see cref="Value"/>, centers the option in the wheel, and emits <see cref="ValueChanged"/>.
    /// </summary>
    private async Task SelectAsync(string value)
    {
        if (Disabled || value == Value) return;
        Value = value;
        // A tap moves the wheel by one selection: one tick, like Ionic's smooth scroll to the option.
        ExtendHapticSelection();
        Haptics.SelectionChanged();
        ScrollActiveIntoView();
        await ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    /// <summary>
    /// The wheel was scrolled (mouse wheel / drag): select whichever option now sits under the center
    /// of the viewport. Mirrors Ionic's <c>initializeScrollListener</c> scroll callback, which reads
    /// the centered item and calls <c>setValue</c>. Miko then applies the equivalent of Ionic's
    /// mandatory scroll snap so the chosen enabled option lands exactly at the center.
    /// </summary>
    private async Task HandleScroll(ScrollEventArgs args)
    {
        if (Disabled) return;

        var options = _context.Options;
        if (options.Count == 0) return;

        var centeredIndex = OptionIndexForScrollTop(args.ScrollTop, options.Count);
        var option = FindNearestEnabledOption(options, centeredIndex, args.DeltaY);
        if (option is not { } selectedOption) return;

        // From here on the wheel offset belongs to the user, not to the initial centering.
        _initialScrollApplied = true;
        ExtendHapticSelection();

        var value = selectedOption.Value;
        if (value == Value)
        {
            if (!_fingerDown) ScrollActiveIntoView();
            return;
        }

        Value = value;
        // The wheel moved onto another option: this is the "click" of the gear. It precedes
        // ValueChanged because the parent's re-render may dispose this instance (ending the session).
        Haptics.SelectionChanged();

        // Under the finger: the re-render this scroll callback triggers highlights the new option;
        // the offset and the binding are settled on release.
        if (_fingerDown) return;

        ScrollActiveIntoView();
        await ValueChanged.InvokeAsync(value);
        StateHasChanged();
    }

    /// <summary>
    /// Starts the haptic selection session if none is running and (re)arms its end timer. Ionic
    /// calls <c>hapticSelectionStart</c> on the first scroll callback of a gesture.
    /// </summary>
    private void ExtendHapticSelection()
    {
        lock (_hapticGate)
        {
            _selectionEndTimer ??= new System.Threading.Timer(_ => EndHapticSelection());
            _selectionEndTimer.Change(SelectionEndDelayMs, Timeout.Infinite);
            if (_hapticSelecting) return;
            _hapticSelecting = true;
            Haptics.SelectionStart();
        }
    }

    private void EndHapticSelection()
    {
        lock (_hapticGate)
        {
            if (!_hapticSelecting) return;
            _hapticSelecting = false;
            Haptics.SelectionEnd();
        }
    }

    /// <summary>
    /// A parent re-render (e.g. two-way binding on every tick) recreates the column mid-gesture
    /// (ISSUE-138 constraint 1), so the session is closed here and the next scroll opens a new one on
    /// the replacement instance. Platform implementations tolerate that split.
    /// </summary>
    protected override void OnDispose()
    {
        System.Threading.Timer? timer;
        lock (_hapticGate)
        {
            timer = _selectionEndTimer;
            _selectionEndTimer = null;
        }
        timer?.Dispose();
        EndHapticSelection();
        base.OnDispose();
    }

    /// <summary>
    /// Centers the currently-selected option by setting the wheel's scroll offset. Reads the option's
    /// index from the ordered <see cref="IonPickerColumnContext.Options"/> list and sets the
    /// <c>.picker-opts</c> scroll box directly (the same imperative write DevTools uses), then
    /// invalidates it so the frame repaints. No-op when the engine or layout is unavailable.
    /// </summary>
    private void ScrollActiveIntoView()
    {
        if (Engine is null || _optsElement is null) return;

        var layout = Engine.GetCurrentLayout();
        if (layout is null) return;

        var optsBox = FindBox(layout, _optsElement);
        if (optsBox is null || !optsBox.HasVerticalScrollbar) return;

        var index = _context.Options.FindIndex(option => option.Value == Value && !option.Disabled);
        if (index < 0) return;

        var target = ScrollTopForOption(index);
        var max = Math.Max(0f, optsBox.ScrollableContentHeight - optsBox.BoxModel.PaddingBox.Height);
        var clamped = Math.Clamp(target, 0f, max);
        if (Math.Abs(optsBox.ScrollTop - clamped) < 0.01f) return;

        optsBox.ScrollTop = clamped;
        Engine.InvalidateElement(optsBox.Element);
    }

    // scrollTop that centers option `index`: its center lands on the 100px viewport center.
    private static float ScrollTopForOption(int index) =>
        (LeadingSpacers + index) * OptionHeight + OptionHeight / 2f - PickerHeight / 2f;

    // Inverse of ScrollTopForOption: the option whose center is closest to the viewport center.
    private static int OptionIndexForScrollTop(float scrollTop, int count)
    {
        var offset = LeadingSpacers * OptionHeight + OptionHeight / 2f - PickerHeight / 2f;
        return Math.Clamp((int)MathF.Round((scrollTop - offset) / OptionHeight), 0, count - 1);
    }

    private static IonPickerColumnOptionInfo? FindNearestEnabledOption(
        IReadOnlyList<IonPickerColumnOptionInfo> options, int centeredIndex, float deltaY)
    {
        if (!options[centeredIndex].Disabled) return options[centeredIndex];

        for (var distance = 1; distance < options.Count; distance++)
        {
            var forward = centeredIndex + distance;
            var backward = centeredIndex - distance;

            // When both sides are equally close, continue in the user's scroll direction.
            if (deltaY >= 0)
            {
                if (forward < options.Count && !options[forward].Disabled) return options[forward];
                if (backward >= 0 && !options[backward].Disabled) return options[backward];
            }
            else
            {
                if (backward >= 0 && !options[backward].Disabled) return options[backward];
                if (forward < options.Count && !options[forward].Disabled) return options[forward];
            }
        }

        return null;
    }

    // Finds the layout box for `element` by walking the (already-laid-out) layout tree.
    private static LayoutBox? FindBox(LayoutBox box, Element element)
    {
        if (ReferenceEquals(box.Element, element)) return box;
        foreach (var child in box.Children)
        {
            var found = FindBox(child, element);
            if (found is not null) return found;
        }
        return null;
    }
}
