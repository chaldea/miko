@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@if (IsClickable)
{
    <div class="@ClassMapper.Class" style="@Style">
        @if (string.IsNullOrEmpty(Href))
        {
            <button class="card-native" @onclick="HandleClick">
                @ChildContent
            </button>
        }
        else
        {
            <a class="card-native" href="@Href" @onclick="HandleClick">
                @ChildContent
            </a>
        }
    </div>
}
else
{
    <div class="@ClassMapper.Class" style="@Style">
        @ChildContent
    </div>
}

@code {
    /// <summary>Named palette color (Ionic <c>color</c>): <c>"primary"</c>, <c>"danger"</c>, ... .</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>When true, wraps the content in a clickable <c>button.card-native</c> surface that
    /// raises <see cref="OnClick"/> (Ionic <c>button</c>).</summary>
    [Parameter] public bool Button { get; set; }

    /// <summary>Route to navigate to (Ionic <c>href</c>). When set, the card is clickable and its
    /// surface is an <c>a</c>; a tap raises <see cref="OnClick"/> and then navigates through the
    /// app's <c>NavigationManager</c> with the mode's page transition, like <see cref="IonItem"/>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Navigation direction for <see cref="Href"/> (Ionic <c>routerDirection</c>):
    /// <c>"forward"</c> (default — push with the mode's transition), <c>"back"</c> (pop-style
    /// transition), or <c>"root"</c> (clear the history, no transition).</summary>
    [Parameter] public string? RouterDirection { get; set; }

    /// <summary>When true, the card is dimmed and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised when the card is tapped; only when it is clickable (<see cref="Button"/> or
    /// <see cref="Href"/>) and not <see cref="Disabled"/>.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsClickable => Button || !string.IsNullOrEmpty(Href);

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-card")
            .If(Disabled, "card-disabled")
            .If(IsClickable, "ion-activatable")
            .If(!string.IsNullOrWhiteSpace(Color), "ion-color")
            .AddColor(Color);
    }

    public override Element Build()
    {
        var root = base.Build();
        if (Disabled)
            root.SetState(ElementState.Disabled);

        if (root.FindByClass("card-native").FirstOrDefault() is { } native && Disabled)
            native.SetState(ElementState.Disabled);

        return root;
    }

    private async Task HandleClick(MouseEventArgs _)
    {
        if (Disabled) return;
        await OnClick.InvokeAsync();
        // card.tsx: an href card navigates like routerLink (openURL), after the click handler.
        NavigateHref(Href, RouterDirection);
    }
}
