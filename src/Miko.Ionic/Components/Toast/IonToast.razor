@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@* Mirrors Ionic's <ion-toast> (toast.tsx render()):
   <ion-toast class="{mode} overlay-hidden? [ion-color ion-color-{color}] toast-translucent?">
     <div class="toast-wrapper toast-{position} toast-layout-baseline">
       <div class="toast-container">
         [start button group: <div class="toast-button-group toast-button-group-start"> <button class="toast-button ...">...</button> </div>]
         [<ion-icon class="toast-icon" icon=Icon />]
         <div class="toast-content">
           [<div class="toast-header">Header</div>]
           [<div class="toast-message">Message</div>]
         </div>
         [end button group: <div class="toast-button-group toast-button-group-end"> ... </div>]
       </div>
     </div>
   </ion-toast>
   A toast is a non-blocking notification: it has NO backdrop. Ionic's overlay controller wires
   `trigger` / `present()`; Miko has no controller, so the host drives IsOpen (two-way) and the
   toast raises OnDidDismiss with the tapped button's role. Cancel-role buttons dismiss without
   running as a normal action; other buttons run their handler then dismiss.
   The host is ALWAYS mounted and keeps its layout box even when closed — `overlay-hidden` maps to
   pointer-events:none rather than display:none (see ToastStyles). That is what makes the
   enter/leave animations possible: Miko detects a transition by diffing the previous frame's
   computed style, so an element that only appears on open has nothing to animate from. The wrapper
   slides/fades between its parked state and its resting offset, mirroring
   animations/{md|ios}.{enter|leave}.ts. `toast-mounted` marks the host interactive while open or
   animating out; it is dropped only after the leave animation finishes (deferred unmount driven by
   AnimationManager.TransitionCompleted), the same pattern as IonActionSheet. *@
<div class="@ClassMapper.Class" style="@Style">
    <div class="@_wrapperClass">
        <div class="toast-container">
            @if (_startButtons.Count > 0)
            {
                <div class="toast-button-group toast-button-group-start">
                    @foreach (var button in _startButtons)
                    {
                        <button class="@ButtonClass(button)" @onclick="@(() => ButtonClickAsync(button))">
                            <div class="toast-button-inner">
                                @if (!string.IsNullOrEmpty(button.Icon))
                                {
                                    <IonIcon Icon="@button.Icon" Class="toast-button-icon" />
                                }
                                @button.Text
                            </div>
                        </button>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(Icon))
            {
                <IonIcon Icon="@Icon" Class="toast-icon" />
            }
            <div class="toast-content">
                @if (Header is not null)
                {
                    <div class="toast-header">@Header</div>
                }
                @if (Message is not null)
                {
                    <div class="toast-message">@Message</div>
                }
            </div>
            @if (_endButtons.Count > 0)
            {
                <div class="toast-button-group toast-button-group-end">
                    @foreach (var button in _endButtons)
                    {
                        <button class="@ButtonClass(button)" @onclick="@(() => ButtonClickAsync(button))">
                            <div class="toast-button-inner">
                                @if (!string.IsNullOrEmpty(button.Icon))
                                {
                                    <IonIcon Icon="@button.Icon" Class="toast-button-icon" />
                                }
                                @button.Text
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>The body message.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Optional bold header shown above the message.</summary>
    [Parameter] public string? Header { get; set; }

    /// <summary>Where the toast sits: <c>"top"</c>, <c>"middle"</c>, or <c>"bottom"</c> (default).</summary>
    [Parameter] public string Position { get; set; } = "bottom";

    /// <summary>Optional leading icon (an Ionicons name) shown before the content.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Named palette color (Ionic <c>color</c>): <c>"primary"</c>, <c>"danger"</c>, ... .
    /// Stamps <c>ion-color ion-color-{color}</c> so the color-scoped rules tint the wrapper.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>The buttons to show. Split into start/end groups by <see cref="IonToastButton.Side"/>.</summary>
    [Parameter] public IReadOnlyList<IonToastButton> Buttons { get; set; } = Array.Empty<IonToastButton>();

    /// <summary>Number of milliseconds before auto-dismissing (Ionic <c>duration</c>).
    /// When greater than zero, the toast dismisses automatically after the specified time.</summary>
    [Parameter] public int Duration { get; set; }

    /// <summary>Whether the toast is presented. Bind two-way with <see cref="IsOpenChanged"/>.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised with the new open state when the toast opens/closes.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>If true, the surface is translucent (ios blur). Marker only in this port.</summary>
    [Parameter] public bool Translucent { get; set; }

    /// <summary>Id of the element that opens the toast (Ionic <c>trigger</c>). Kept for API parity;
    /// the host drives <see cref="IsOpen"/> in this port.</summary>
    [Parameter] public string? Trigger { get; set; }

    /// <summary>Raised when the toast dismisses, with the tapped button's role (or null).</summary>
    [Parameter] public EventCallback<IonOverlayDismissEventArgs> OnDidDismiss { get; set; }

    /// <summary>
    /// The app's animation manager, used to defer the closed state until the leave animation
    /// finishes. Resolved from the ambient service scope; null in a bare unit test, in which case
    /// the toast settles to closed on the same frame (no slide/fade out).
    /// </summary>
    [Inject] protected AnimationManager? Animations { get; set; }

    /// <summary>Marshals the auto-dismiss timer callback back onto the render thread. Null in a bare
    /// unit test, in which case <see cref="Duration"/> is inert.</summary>
    [Inject] private Platform.MikoDispatcher? Dispatcher { get; set; }

    private IReadOnlyList<IonToastButton> _startButtons = Array.Empty<IonToastButton>();
    private IReadOnlyList<IonToastButton> _endButtons = Array.Empty<IonToastButton>();
    private string _wrapperClass = "toast-wrapper ion-overlay-wrapper toast-bottom toast-layout-baseline";

    // Stays true through the leave animation, so the toast keeps its on-screen state while fading
    // out; cleared once the leave transition completes.
    private bool _mounted;
    private bool _subscribed;

    // Guards against re-arming the auto-dismiss timer on every re-render while the toast stays open.
    private bool _timerScheduled;
    private CancellationTokenSource? _timerCancellation;

    protected override void OnParametersSet()
    {
        if (!_subscribed && Animations is not null)
        {
            Animations.TransitionCompleted += OnTransitionCompleted;
            _subscribed = true;
        }

        if (IsOpen) _mounted = true;

        var position = string.IsNullOrEmpty(Position) ? "bottom" : Position.ToLowerInvariant();

        // Closed AND settled → overlay-hidden (inert). While open or animating out the host stays
        // mounted/interactive; only `toast-open` (which drives the animation end state) is tied
        // strictly to IsOpen.
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-toast")
            .If(!IsOpen && !_mounted, "overlay-hidden")
            .If(_mounted, "toast-mounted")
            .If(IsOpen, "toast-open")
            .If(!string.IsNullOrEmpty(Color), "ion-color")
            .AddColor(Color)
            .If(Translucent, "toast-translucent");

        _wrapperClass = $"toast-wrapper ion-overlay-wrapper toast-{position} toast-layout-baseline";

        // Start group = side "start"; everything else (including undefined) goes end (toast.tsx).
        _startButtons = Buttons.Where(b => b.IsStart).ToList();
        _endButtons = Buttons.Where(b => !b.IsStart).ToList();

        // Schedule auto-dismiss when opening with a positive duration (toast.tsx presentOverlay →
        // durationTimeout). Re-arming is guarded so a re-render mid-toast doesn't restart the clock.
        if (IsOpen && Duration > 0 && !_timerScheduled && Dispatcher is not null)
        {
            _timerScheduled = true;
            ScheduleAutoDismiss();
        }

        // Closed → drop the flag and cancel any pending timer, so re-opening arms a fresh one.
        if (!IsOpen)
        {
            _timerScheduled = false;
            _timerCancellation?.Cancel();
            _timerCancellation = null;
        }
    }

    private void ScheduleAutoDismiss()
    {
        if (Dispatcher is null) return;

        _timerCancellation?.Cancel();
        _timerCancellation = new CancellationTokenSource();
        var token = _timerCancellation.Token;
        var dispatcher = Dispatcher;

        _ = Task.Delay(Duration, token).ContinueWith(_ =>
        {
            if (token.IsCancellationRequested) return;

            // Hop back to the render thread before touching component state.
            dispatcher.Post(async () =>
            {
                if (token.IsCancellationRequested) return;
                if (IsOpen)
                {
                    // A timed dismiss carries the "timeout" role (toast.tsx dismiss(undefined, 'timeout')).
                    await DismissAsync("timeout");
                    StateHasChanged();
                }
            });
        }, TaskContinuationOptions.OnlyOnRanToCompletion);
    }

    // toast-button + icon-only/role/state markers (toast.tsx buttonClass()).
    private static string ButtonClass(IonToastButton button)
    {
        var cls = "toast-button ion-focusable ion-activatable";
        if (button.IsIconOnly) cls += " toast-button-icon-only";
        if (!string.IsNullOrEmpty(button.Role)) cls += $" toast-button-{button.Role.ToLowerInvariant()}";
        if (!string.IsNullOrEmpty(button.CssClass)) cls += $" {button.CssClass}";
        return cls;
    }

    private async Task ButtonClickAsync(IonToastButton button)
    {
        // Cancel buttons dismiss without running as a normal action; others run then dismiss.
        if (!button.IsCancel)
        {
            button.Handler?.Invoke();
        }
        await DismissAsync(button.Role);
    }

    private async Task DismissAsync(string? role)
    {
        if (IsOpen)
        {
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(false);

            // The toast is closing: stop the auto-dismiss timer so a pending tick can't fire a
            // second dismiss after a button/host-driven close.
            _timerScheduled = false;
            _timerCancellation?.Cancel();
            _timerCancellation = null;

            // Without an animation manager nothing will report the leave animation as finished, so
            // settle to the closed (inert) state immediately rather than staying mounted forever.
            if (Animations is null) _mounted = false;
        }
        await OnDidDismiss.InvokeAsync(new IonOverlayDismissEventArgs(role, null));
    }

    protected override void OnDispose()
    {
        // Nested components are rebuilt each render; release the subscription so handlers from
        // discarded instances don't accumulate, and drop the pending timer with them.
        if (_subscribed && Animations is not null)
        {
            Animations.TransitionCompleted -= OnTransitionCompleted;
            _subscribed = false;
        }
        _timerCancellation?.Cancel();
        _timerCancellation = null;
    }

    private void OnTransitionCompleted(Element element, string property)
    {
        // Once the wrapper's leave animation finishes, drop the mounted state so the host settles to
        // overlay-hidden (pointer-events:none) and stops intercepting taps. Guarded against a
        // re-open mid-dismiss, and against the enter animation's completion. md fades the wrapper
        // (Opacity) while ios slides it (Transform), so either property ends the leave.
        if (!IsOpen
            && _mounted
            && (property == nameof(Style.Transform) || property == nameof(Style.Opacity))
            && (element.Class?.Contains("toast-wrapper") ?? false))
        {
            _mounted = false;
            StateHasChanged();
        }
    }
}
