@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@* Mirrors Ionic's <ion-infinite-scroll> (infinite-scroll.tsx): a zero-chrome host that watches the
   enclosing content's scroll position and emits ionInfinite once the threshold is crossed.

   Ionic resolves the scroll element in connectedCallback (findClosestIonContent + getScrollElement)
   and registers a native scroll listener on it. Miko components cannot reach an ancestor at build
   time, so the engine instead delivers the scroll event *down* into the scroll container's subtree
   (MikoEngine.ScrollBy → EventDispatcher.DispatchToDescendants). The host's OnScroll therefore
   fires with the scroll container's geometry — carried on ScrollEventArgs as ScrollHeight /
   ClientHeight — which is exactly what the threshold formula needs.

   Two Miko-specific arrangements keep scrolling cheap and the loading state intact:

   - The scroll listener is a plain Element.OnScroll delegate, not @onscroll. An @onscroll
     EventCallback re-renders this component after every call, i.e. on every scrolled frame. The
     replaced host restyles and relays out the whole page, so a scroll frame cost as much as a full
     page build and grew with every row loaded. Like Ionic's native listener, the delegate re-renders
     nothing.
   - The loading state lives in an InfiniteScrollSession, not on this instance. OnInfinite's receiver
     (the page) re-renders the moment an async handler yields, which builds a new instance of this
     component; state kept on the instance was gone at once, so every further scroll event fired
     OnInfinite again and one threshold crossing loaded batch after batch. The host is an
     InfiniteScrollHostElement; ComponentBase pairs it with its predecessor on every re-render
     (TransferRuntimeState), and its CopyInteractionStateFrom hands the session to the new instance. *@
@RenderHost()

@code {
    /// <summary>
    /// Threshold distance from the edge of the content at which <see cref="OnInfinite"/> fires.
    /// Either a percentage of the viewport height (<c>"15%"</c>, the default) or a pixel distance
    /// (<c>"100px"</c>).
    /// </summary>
    [Parameter] public string Threshold { get; set; } = "15%";

    /// <summary>When true, the infinite scroll is hidden and does not emit events.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Position of the infinite scroll marker: <c>"bottom"</c> (default) or <c>"top"</c>.</summary>
    [Parameter] public string Position { get; set; } = "bottom";

    /// <summary>Declarative loading state. Use <see cref="Complete"/> to reset it from code.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Raised when the scroll position crosses the threshold. The handler must call
    /// <see cref="IonInfiniteScrollCustomEvent.Complete"/> once its async work is done, otherwise
    /// the infinite scroll stays in the loading state and never fires again.
    /// </summary>
    [Parameter] public EventCallback<IonInfiniteScrollCustomEvent> OnInfinite { get; set; }

    private const string LoadingClass = "infinite-scroll-loading";

    // Parsed threshold: exactly one of the two is non-zero (infinite-scroll.tsx thresholdChanged()).
    // _thrPc is a fraction of the viewport height; _thrPx is an absolute pixel distance.
    private float _thrPc;
    private float _thrPx;

    private InfiniteScrollSession _session;

    // The host element this instance rendered. Needed for the threshold formula, which subtracts this
    // component's own height (Ionic's `this.el.offsetHeight`).
    private Element? _hostElement;

    public IonInfiniteScroll() => _session = new InfiniteScrollSession(this);

    protected override void OnParametersSet()
    {
        ParseThreshold();
        ApplyParameters();
        BuildClass();
    }

    /// <summary>Applies the parameters that drive the loading state to the session.</summary>
    private void ApplyParameters()
    {
        if (Disabled)
        {
            _session.IsLoading = false;
            _session.DidFire = false;
        }
        else if (Loading)
        {
            _session.IsLoading = true;
        }
    }

    /// <summary>
    /// Call this once the work started by <see cref="OnInfinite"/> has finished. Clears the loading
    /// state and re-arms the infinite scroll for the next threshold crossing.
    /// </summary>
    public Task Complete()
    {
        if (!ReferenceEquals(_session.Owner, this)) return _session.Owner.Complete();

        // infinite-scroll.tsx complete(): a no-op unless we are actually loading.
        if (!_session.IsLoading) return Task.CompletedTask;

        _session.IsLoading = false;
        _session.DidFire = false;
        SyncHostClass();
        return Task.CompletedTask;
    }

    private RenderFragment RenderHost() => builder =>
    {
        var host = builder.OpenElement<InfiniteScrollHostElement>();
        host.InfiniteScroll = this;
        host.Class = ClassMapper.Class;
        RenderTreeBuilder.SetStyle(host, Style);
        host.OnScroll = HandleScroll;
        builder.AddContent(0, ChildContent);
        builder.CloseElement();
        _hostElement = host;
    };

    private void HandleScroll(ScrollEventArgs args)
    {
        if (!ReferenceEquals(_session.Owner, this))
        {
            _session.Owner.HandleScroll(args);
            return;
        }

        // canStart(): infinite-scroll.tsx
        var s = _session;
        if (Disabled || s.IsLoading || s.DidFire) return;

        // Ionic's `infiniteHeight = this.el.offsetHeight`. CurrentTarget is the element the engine
        // is delivering to, i.e. the one in the live tree; _hostElement is the fallback for direct
        // handler invocations in tests.
        var host = args.CurrentTarget ?? _hostElement;
        var infiniteHeight = host?.OffsetHeight ?? 0f;

        // A re-render hands the replacement host a layout box that carries the computed style but not
        // the measured box, so OffsetHeight reads 0 until the next full layout pass. The page
        // re-renders on every load, so fall back to the last measured height.
        if (infiniteHeight > 0f) s.LastKnownHeight = infiniteHeight;
        else infiniteHeight = s.LastKnownHeight;

        // "if there is no height of this element then do nothing" — also covers the never-laid-out
        // case, where every geometry read would be 0 and the formula would fire spuriously.
        if (infiniteHeight <= 0f) return;

        var threshold = _thrPc != 0f ? args.ClientHeight * _thrPc : _thrPx;

        var distanceFromInfinite = IsTop
            ? args.ScrollTop - infiniteHeight - threshold
            : args.ScrollHeight - infiniteHeight - args.ScrollTop - threshold - args.ClientHeight;

        if (distanceFromInfinite >= 0f) return;

        s.IsLoading = true;
        s.DidFire = true;
        // Show the loading state immediately — the handler's async work may take a while.
        SyncHostClass();

        _ = OnInfinite.InvokeAsync(new IonInfiniteScrollCustomEvent(this));
    }

    private bool IsTop => string.Equals(Position, "top", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// infinite-scroll.tsx <c>thresholdChanged()</c>: a percentage becomes a fraction of the
    /// viewport height, anything else is read as pixels. The two are mutually exclusive.
    /// </summary>
    private void ParseThreshold()
    {
        _thrPc = 0f;
        _thrPx = 0f;

        var text = Threshold?.Trim();
        if (string.IsNullOrEmpty(text)) return;

        if (text.EndsWith("%", StringComparison.Ordinal))
        {
            if (float.TryParse(text[..^1], out var pc)) _thrPc = pc / 100f;
            return;
        }

        if (text.EndsWith("px", StringComparison.OrdinalIgnoreCase)) text = text[..^2];
        if (float.TryParse(text, out var px)) _thrPx = px;
    }

    private void BuildClass()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-infinite-scroll")
            .If(!Disabled, "infinite-scroll-enabled")
            .If(_session.IsLoading, LoadingClass)
            .If(IsTop, "infinite-scroll-top");
    }

    /// <summary>
    /// Brings the rendered host's loading class in line with the session, without re-rendering. Only
    /// that token is rewritten: the host also carries the <c>ion-theme-*</c> scope class stamped on it
    /// after this component rendered it (IonicComponentBase), and every rule matches through it.
    /// </summary>
    private void SyncHostClass()
    {
        BuildClass();
        var host = _hostElement;
        if (host is null) return;

        var tokens = new List<string>();
        foreach (var token in (host.Class ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            if (token != LoadingClass) tokens.Add(token);
        }
        if (_session.IsLoading) tokens.Add(LoadingClass);

        var cls = string.Join(' ', tokens);
        if (cls != host.Class) host.Class = cls;
    }

    /// <summary>
    /// Takes over from <paramref name="previous"/>, whose host was just replaced by this instance's
    /// (or re-applies the session when this instance rebuilt its own host).
    /// </summary>
    private void TakeOver(IonInfiniteScroll previous)
    {
        if (!ReferenceEquals(previous, this))
        {
            // The load in flight carries on in this instance; the parameters the parent has just
            // rendered still apply on top of it (Disabled ends it, Loading declares one).
            _session = previous._session;
            _session.Owner = this;
            ApplyParameters();
        }

        // The host was rendered from this instance's own state, before it had the session.
        SyncHostClass();
    }

    /// <summary>
    /// The loading state of one infinite scroll, shared by the successive component instances that
    /// render it. <see cref="Owner"/> is the newest; the older ones forward to it.
    /// </summary>
    private sealed class InfiniteScrollSession(IonInfiniteScroll owner)
    {
        public IonInfiniteScroll Owner = owner;
        public bool IsLoading;

        // didFire keeps ionInfinite from firing repeatedly while the user keeps scrolling inside the
        // threshold band; it is only re-armed by Complete().
        public bool DidFire;

        // Last measured host height, kept across the re-renders that momentarily clear the measured
        // box.
        public float LastKnownHeight;
    }

    /// <summary>
    /// The infinite scroll's root element. On every re-render it is paired with the host it replaces,
    /// and hands that host's session to the component instance that built it.
    /// </summary>
    private sealed class InfiniteScrollHostElement : DivElement
    {
        public IonInfiniteScroll? InfiniteScroll { get; set; }

        protected override void CopyInteractionStateFrom(Element old)
        {
            base.CopyInteractionStateFrom(old);
            if (old is InfiniteScrollHostElement { InfiniteScroll: { } previous } && InfiniteScroll is { } current)
                current.TakeOver(previous);
        }
    }
}
