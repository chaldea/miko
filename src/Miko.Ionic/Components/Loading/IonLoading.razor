@namespace Miko.Ionic.Components
@inherits IonicComponentBase
@using Miko.Platform
@* Mirrors Ionic's <ion-loading> (loading.tsx render()):
   <ion-loading class="{mode} overlay-hidden? loading-translucent?" role="dialog">
     <ion-backdrop visible=showBackdrop tappable=backdropDismiss />
     <div class="loading-wrapper ion-overlay-wrapper">
       [<div class="loading-spinner"><ion-spinner name=spinner /></div>]   <!-- if a spinner is shown -->
       [<div class="loading-content">Message</div>]                        <!-- if Message is set -->
     </div>
   </ion-loading>
   Miko supports both the declarative IsOpen path and IonLoadingController. The indicator raises
   OnDidDismiss (role null on a normal
   dismiss, "backdrop" when the backdrop is tapped). The host is always mounted; when closed it
   carries `overlay-hidden` (display:none). Loading blocks input by default (backdrop is NOT
   tappable — BackdropDismiss defaults to false). *@
<IonPortal Id="@(OverlayId ?? _overlayId)" Active="IsOpen">
<div class="@HostClass" style="@Style" role="dialog">
    @if (ShowBackdrop)
    {
        <div class="ion-backdrop loading-backdrop" @onclick="OnBackdropTapAsync"></div>
    }
    <div class="loading-wrapper ion-overlay-wrapper">
        @if (!string.IsNullOrEmpty(_spinner))
        {
            <div class="loading-spinner">
                <IonSpinner Name="@_spinner" />
            </div>
        }
        @if (Message is not null)
        {
            <div class="loading-content">@Message</div>
        }
    </div>
</div>
</IonPortal>

@code {
    /// <summary>
    /// The host class, evaluated while rendering (ISSUE-153). It carries the theme scope class
    /// because the host is drawn in IonApp's overlay layer, away from this component's root, so
    /// <see cref="IonicComponentBase"/> cannot stamp it there — without it none of the overlay's
    /// rules matched in the layer. The open / mounted markers are computed here too, so a self
    /// re-render through the parentless branch (which skips OnParametersSet) still reflects them.
    /// </summary>
    private string HostClass => Join(ClassMapper.Class, ThemeScopeClass, IsOpen ? null : "overlay-hidden");

    private readonly string _overlayId = $"loading-{Guid.NewGuid():N}";
    /// <summary>Optional stable identifier used by the root overlay registry.</summary>
    [Parameter] public string? OverlayId { get; set; }

    /// <summary>Optional text content shown beside/under the spinner.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>The spinner preset name (see <see cref="IonSpinner"/>). When null it falls back to
    /// the per-mode default (<c>"lines"</c> on ios, <c>"crescent"</c> on md — loading.tsx
    /// <c>componentWillLoad</c>). Pass an empty string to hide the spinner entirely.</summary>
    [Parameter] public string? Spinner { get; set; }

    /// <summary>Number of milliseconds before auto-dismissing (Ionic <c>duration</c>).
    /// When greater than zero, the loading indicator dismisses automatically after the specified time.</summary>
    [Parameter] public int Duration { get; set; }

    /// <summary>Whether the indicator is presented. Bind two-way with <see cref="IsOpenChanged"/>.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised with the new open state when the indicator opens/closes.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>If true, tapping the backdrop dismisses the indicator. Defaults to <c>false</c>
    /// (loading blocks interaction — loading.tsx <c>backdropDismiss = false</c>).</summary>
    [Parameter] public bool BackdropDismiss { get; set; }

    /// <summary>If true (default), a backdrop is shown behind the indicator (loading.tsx
    /// <c>showBackdrop = true</c>).</summary>
    [Parameter] public bool ShowBackdrop { get; set; } = true;

    /// <summary>If true, the surface is translucent (ios blur). Marker only in this port.</summary>
    [Parameter] public bool Translucent { get; set; }

    /// <summary>Id of the element that opens the indicator (Ionic <c>trigger</c>). Kept for API
    /// parity; the host drives <see cref="IsOpen"/> in this port.</summary>
    [Parameter] public string? Trigger { get; set; }

    /// <summary>Raised when the indicator dismisses (null role on a normal dismiss, <c>"backdrop"</c>
    /// when the backdrop is tapped).</summary>
    [Parameter] public EventCallback<IonOverlayDismissEventArgs> OnDidDismiss { get; set; }

    [Inject] private Platform.MikoDispatcher? Dispatcher { get; set; }

    private string? _spinner;
    private bool _timerScheduled;
    private CancellationTokenSource? _timerCancellation;

    protected override void OnParametersSet()
    {
        // A null Spinner resolves to the per-mode default; an explicit "" hides the spinner.
        _spinner = Spinner ?? (Mode == "ios" ? "lines" : "crescent");

        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-loading")
            .If(Translucent, "loading-translucent");

        // Off by default, as in Ionic: a loading indicator's BackdropDismiss defaults to false.
        RegisterBackHandler(IsOpen && BackdropDismiss ? HandleBack : null, BackButtonPriority.Overlay);

        // Schedule auto-dismiss when opening with a positive duration.
        if (IsOpen && Duration > 0 && !_timerScheduled && Dispatcher != null)
        {
            _timerScheduled = true;
            ScheduleAutoDismiss();
        }

        // Reset timer flag and cancel pending timer when closed (allow re-opening with a new timer).
        if (!IsOpen)
        {
            _timerScheduled = false;
            _timerCancellation?.Cancel();
            _timerCancellation = null;
        }
    }

    private void ScheduleAutoDismiss()
    {
        if (Dispatcher == null) return;

        // Cancel any existing timer before starting a new one.
        _timerCancellation?.Cancel();
        _timerCancellation = new CancellationTokenSource();
        var token = _timerCancellation.Token;

        _ = Task.Delay(Duration, token).ContinueWith(async _ =>
        {
            // If the timer was cancelled, don't dismiss.
            if (token.IsCancellationRequested) return;

            // Post the dismiss action back to the render thread via the dispatcher.
            Dispatcher.Post(async () =>
            {
                if (IsOpen)
                {
                    await DismissAsync(null);
                    StateHasChanged();
                }
            });
        }, TaskContinuationOptions.OnlyOnRanToCompletion);
    }

    private async Task OnBackdropTapAsync(MouseEventArgs _)
    {
        if (!BackdropDismiss) return;
        await DismissAsync("backdrop");
    }

    /// <summary>
    /// The system back button dismisses the open loading indicator with role <c>"back"</c> when
    /// <see cref="BackdropDismiss"/> allows it — Ionic's overlays.ts answers back for the topmost
    /// overlay whose backdropDismiss is true (ISSUE-153; modal and action sheet did since ISSUE-138).
    /// </summary>
    private bool HandleBack()
    {
        // Re-check at dispatch time: the registration reflects the last render.
        if (!IsOpen) return false;
        _ = DismissFromBackAsync();
        return true;
    }

    /// <summary>
    /// Cancels a pending auto-dismiss: a timer outliving the instance would raise
    /// <see cref="IsOpenChanged"/> for an indicator that no longer exists.
    /// </summary>
    protected override void OnDispose()
    {
        _timerCancellation?.Cancel();
        _timerCancellation = null;
        base.OnDispose();
    }

    // A tap re-renders this component through its EventCallback; the back button does not, so
    // render the closed state here or an unbound overlay stays on screen.
    private async Task DismissFromBackAsync()
    {
        await DismissAsync("back");
        StateHasChanged();
    }

    private async Task DismissAsync(string? role)
    {
        ClearBackHandler();

        if (IsOpen)
        {
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(false);
        }
        await OnDidDismiss.InvokeAsync(new IonOverlayDismissEventArgs(role, null));
    }
}
