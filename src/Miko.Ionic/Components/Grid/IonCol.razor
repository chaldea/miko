@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<div class="@ClassMapper.Class" Style="@_mergedStyle">
    @ChildContent
</div>

@code {
    /// <summary>Column size (Ionic <c>size</c>): a count from <c>"1"</c> to <c>"12"</c> (the column
    /// takes that many twelfths of the row and does not grow or shrink), or <c>"auto"</c> (sized to
    /// its content). When null, the column shares the remaining row width equally. Other values are
    /// ignored. Not breakpoint-aware.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Left margin of this many twelfths of the row width, <c>"1"</c>–<c>"12"</c> (Ionic
    /// <c>offset</c>). Moves the following columns too.</summary>
    [Parameter] public string? Offset { get; set; }

    /// <summary>Shifts the column right by this many twelfths of the row width, <c>"1"</c>–<c>"12"</c>
    /// (Ionic <c>push</c>), using relative positioning; other columns keep their places.</summary>
    [Parameter] public string? Push { get; set; }

    /// <summary>Shifts the column left by this many twelfths of the row width, <c>"1"</c>–<c>"12"</c>
    /// (Ionic <c>pull</c>), using relative positioning; other columns keep their places.</summary>
    [Parameter] public string? Pull { get; set; }

    private Style? _mergedStyle;

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-col");

        var columnStyle = BuildColumnStyle();

        if (Style is not null && columnStyle is not null)
        {
            _mergedStyle = new Style();
            _mergedStyle.Merge(Style);
            _mergedStyle.Merge(columnStyle);
        }
        else
        {
            _mergedStyle = columnStyle ?? Style;
        }
    }

    private Style? BuildColumnStyle()
    {
        Style? style = null;

        if (!string.IsNullOrWhiteSpace(Size))
        {
            style ??= new Style();
            if (string.Equals(Size, "auto", StringComparison.OrdinalIgnoreCase))
            {
                style.FlexGrow = 0;
                style.FlexShrink = 0;
                style.FlexBasis = Length.Auto;
                style.Width = Length.Auto;
                style.MaxWidth = Length.Percent(100);
            }
            else if (TryColumnPercent(Size, out var sizePercent))
            {
                style.FlexGrow = 0;
                style.FlexShrink = 0;
                style.FlexBasis = Length.Percent(sizePercent);
                style.Width = Length.Percent(sizePercent);
                style.MaxWidth = Length.Percent(sizePercent);
            }
        }

        if (TryColumnPercent(Offset, out var offsetPercent))
        {
            style ??= new Style();
            style.MarginLeft = Length.Percent(offsetPercent);
        }

        if (TryColumnPercent(Push, out var pushPercent))
        {
            style ??= new Style();
            style.Left = Length.Percent(pushPercent);
        }

        if (TryColumnPercent(Pull, out var pullPercent))
        {
            style ??= new Style();
            style.Right = Length.Percent(pullPercent);
        }

        return style;
    }

    private static bool TryColumnPercent(string? value, out float percent)
    {
        percent = 0;
        if (!float.TryParse(value, out var columns)) return false;
        if (columns <= 0 || columns > 12) return false;
        percent = columns / 12f * 100f;
        return true;
    }
}
