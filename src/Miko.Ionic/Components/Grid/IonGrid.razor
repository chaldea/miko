@namespace Miko.Ionic.Components
@inherits IonicComponentBase
<div class="@ClassMapper.Class" style="@Style">
    @ChildContent
</div>

@code {
    /// <summary>When true, caps the grid at the <c>Grid.FixedWidth</c> theme token (1140px by
    /// default) and centers it (Ionic <c>fixed</c>; Ionic's per-breakpoint widths are not
    /// ported).</summary>
    [Parameter] public bool Fixed { get; set; }

    protected override void OnParametersSet()
    {
        ClassMapper
            .Clear()
            .Add(Class)
            .Add(Mode)
            .Add("ion-grid")
            .If(Fixed, "grid-fixed");
    }
}
