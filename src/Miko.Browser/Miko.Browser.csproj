<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>true</IsPackable>
    <PackageId>Miko.Browser</PackageId>
    <Authors>Miko</Authors>
    <Description>Browser WebAssembly host for Miko: Canvas rendering, browser input, and supported native capabilities.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574</NoWarn>
    <PackageTags>miko;browser;webassembly;wasm;skiasharp;ui</PackageTags>
    <PackageProjectUrl>https://github.com/chaldea/miko</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chaldea/miko</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Miko.Browser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miko\Miko.csproj" />
    <ProjectReference Include="..\Miko.Native\Miko.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.158.0-preview.1.26556.2" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0.300-preview.1.26556.2" />
  </ItemGroup>

</Project>
