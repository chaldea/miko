<Project>

  <!--
    Local NuGet feed. `dotnet pack` writes every package to <repo>/packages, which the in-repo
    templates (templates/*/nuget.config) restore Miko* packages from, so the templates build
    against the current sources instead of a machine-specific feed. The directory is git-ignored.
    CI passes an explicit `-o`, which takes precedence over this default.
  -->
  <PropertyGroup>
    <PackageOutputPath>$(MSBuildThisFileDirectory)packages</PackageOutputPath>
  </PropertyGroup>

  <!--
    Centralized versioning for all packages.
    - VersionPrefix: base version (1.0.0)
    - VersionSuffix: defaults to "dev" for local builds, CI overrides with preview/release tags
    - Local builds produce 1.0.0-dev, which sorts lower than 1.0.0-preview.N in NuGet
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>

  <!--
    Every package carries the third-party notices (Ionicons, Ionic Framework, the forked Razor
    compiler and its bundled Roslyn/ObjectPool, the template app icon). Pack metadata is ignored
    by projects that are not packed.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
