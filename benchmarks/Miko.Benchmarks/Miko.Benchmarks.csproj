<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A local benchmark harness, not a shipped library: the publish workflow packs every
         packable project in miko.slnx. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Miko\Miko.csproj" />
  </ItemGroup>

  <!-- White-box: reads rendered pixels through SkiaSharp. Miko keeps Skia out of its public surface
       (ISSUE-162), so the package is referenced here and the engine is driven through the shim below. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <Compile Include="..\..\tests\Shared\SkiaCanvasExtensions.cs" Link="Shared\SkiaCanvasExtensions.cs" />
  </ItemGroup>

</Project>
