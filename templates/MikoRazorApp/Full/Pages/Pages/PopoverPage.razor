@page "/popover"
@using Miko.Events
@* NOTE: Ionic creates the popover imperatively via popoverController.create({ component, event }),
   anchoring it to the click event. Miko's IonPopover is declarative — the host binds IsOpen and the
   content is written inline rather than resolved from a component tag. *@

<IonPage>
    <IonHeader>
        <IonToolbar>
            <Start>
                <IonBackButton DefaultHref="/"></IonBackButton>
            </Start>
            <End>
                <IonButtons>
                    <IonButton OnClick="@ShowPopover">
                        <IconOnly>
                            <IonIcon Ios="@Ionicons.EllipsisHorizontal" Md="@Ionicons.EllipsisVertical" Slot="icon-only"></IonIcon>
                        </IconOnly>
                    </IonButton>
                </IonButtons>
            </End>
            <ChildContent>
                <IonTitle>Popover</IonTitle>
            </ChildContent>
        </IonToolbar>
    </IonHeader>
    <IonContent Fullscreen>
        <ComponentDetails Name="Popover">
            The Popover is a dialog that appears on top of the current page. It can be used for
            anything, but generally it is used for overflow actions that don't fit in the navigation bar.
        </ComponentDetails>

        <div class="ion-padding-start ion-padding-end">
            <IonButton Class="ion-text-wrap" Expand="block" OnClick="@ShowPopover">Open Popover</IonButton>
        </div>
    </IonContent>
</IonPage>
@code {
    [Inject] public IonPopoverController PopoverController { get; set; }

    private RenderFragment _popList =@<IonList>
                                          <IonListHeader>
                                              <IonLabel>Ionic</IonLabel>
                                          </IonListHeader>
                                          <IonItem Button>Learn Ionic</IonItem>
                                          <IonItem Button>Documentation</IonItem>
                                          <IonItem Button>Showcase</IonItem>
                                          <IonItem Button>GitHub Repo</IonItem>
                                      </IonList>
    ;

    private async Task ShowPopover(MouseEventArgs args)
    {
        var popover = await PopoverController.CreateAsync(new IonPopoverOptions()
        {
            Content = _popList,
            Event = args,
            Translucent = true,
        });
        await popover.PresentAsync();
    }
}
