<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>Latest</RazorLangVersion>
    <StartupObject>MikoRazorApp.Program</StartupObject>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!--
      Miko renders with SkiaSharp, not the browser, so the Razor SDK's web-asset
      pipeline is not used. Turn it off to avoid pulling in static web asset
      processing from transitive ASP.NET Core dependencies.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (useFull) -->
    <EmbeddedResource Include="Assets\**\*" />
    <!--#endif -->
    <PackageReference Include="Miko" Version="1.0.0-dev" />
    <PackageReference Include="Miko.Windowing" Version="1.0.0-dev" />
    <!-- DevTools (F12 inspector) is a debugging aid: Release builds do not reference it. -->
    <PackageReference Include="Miko.DevTools" Version="1.0.0-dev" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Miko.Razor.Compiler" Version="1.0.0-dev" />
    <!--#if (useIonic) -->
    <PackageReference Include="Miko.Ionic" Version="1.0.0-dev" />
    <!--#endif -->
  </ItemGroup>

</Project>
