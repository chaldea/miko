@page "/infinite-scroll"
@using Miko.Components.Virtualization

@* NOTE: the original demo loads gravatar images over the network for each row. Miko's demo
   resources are embedded, so the bundled avatar asset is used instead.

   The rows are virtualized (ISSUE-151): only the rows on screen, plus a few on either side, are in the
   DOM, so every load and every scrolled frame costs the same however many rows have been loaded.
   Virtualize sits inside IonList and renders the IonItems as the list's children, so they are styled as
   before; ItemSize is the estimated row height, used until rows have been measured. *@

<IonPage>
    <IonHeader>
        <IonToolbar>
            <Start>
                <IonBackButton DefaultHref="/"></IonBackButton>
            </Start>
            <ChildContent>
                <IonTitle>Infinite Scroll</IonTitle>
            </ChildContent>
        </IonToolbar>
    </IonHeader>
    <IonContent>
        <IonList>
            <Virtualize Items="@_items" ItemKey="@(user => user.Id)" ItemSize="72" Context="user">
                <IonItem>
                    <Start>
                        <IonAvatar>
                            <img src="res://Assets/avatar.svg" />
                        </IonAvatar>
                    </Start>
                    <ChildContent>
                        <IonLabel Class="sc-ion-label-md-s">
                            <h2>@user.Name</h2>
                            <p>Created @user.Created</p>
                        </IonLabel>
                    </ChildContent>
                </IonItem>
            </Virtualize>
        </IonList>

        <IonInfiniteScroll Threshold="100px" OnInfinite="@HandleInfinite">
            <IonInfiniteScrollContent LoadingSpinner="bubbles" LoadingText="Loading more data...">
            </IonInfiniteScrollContent>
        </IonInfiniteScroll>
    </IonContent>
</IonPage>
@code {
    private record User(string Name, string Created)
    {
        // The demo repeats names at random, so each row gets its own id for ItemKey.
        public int Id { get; init; }
