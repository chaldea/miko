        new("Richard Aaron", "April 27, 2016"),
    };

    private readonly List<User> _items = Users.Take(15).Select((user, i) => user with { Id = i }).ToList();

    private async Task HandleInfinite(IonInfiniteScrollCustomEvent e)
    {
        // Stand-in for a network request.
        await Task.Delay(500);

        for (var i = 0; i < 5; i++)
        {
            _items.Add(Users[_random.Next(Users.Length)] with { Id = _items.Count });
        }

        // Render the new rows first, then clear the loading state — completing before the list has
        // grown would re-arm the infinite scroll while the content is still short.
        StateHasChanged();

        await e.Complete();
    }
}
