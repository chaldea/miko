<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Local feed that hosts the Miko packages: <repo>/packages, where `dotnet pack miko.slnx`
      (and `dotnet pack templates/Miko.Templates.csproj`) write by default (see the repo-root
      Directory.Build.props). Pack before restoring this template inside the repo.

      NuGet caches packages by version and every local pack is 1.0.0-dev, so after re-packing remove
      the stale copies before restoring again:  rm -rf ~/.nuget/packages/miko*

      This file only serves the in-repo template; Miko.Templates.csproj does not pack it.
    -->
    <add key="miko-local" value="../../packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    Map the Miko packages to the local feed and everything else to nuget.org. Once a mapping
    exists, a package that matches no pattern cannot be restored from any source (NU1100), so
    the catch-all entry is required — e.g. for the runtime packs of `dotnet publish -r linux-x64`.
  -->
  <packageSourceMapping>
    <packageSource key="miko-local">
      <package pattern="Miko*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
