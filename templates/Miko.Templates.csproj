<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Miko.Templates</PackageId>
    <Authors>Miko</Authors>
    <Description>dotnet new templates for building Miko apps with Razor components — desktop and cross-platform (Desktop/Android/iOS).</Description>
    <PackageTags>miko;razor;template;dotnet-new</PackageTags>
    <PackageProjectUrl>https://github.com/chaldea/miko</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chaldea/miko</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!--
    Pack the template sources as package content. Local-feed nuget.config files and any
    build artifacts are excluded so they never ship inside the template package.
  -->
  <ItemGroup>
    <Content Include="MikoRazorApp\**\*"
             Exclude="MikoRazorApp\**\bin\**;MikoRazorApp\**\obj\**;MikoRazorApp\nuget.config;MikoRazorApp\**\*.user"
             PackagePath="content\MikoRazorApp" />
    <Content Include="MikoMultiplatformApp\**\*"
             Exclude="MikoMultiplatformApp\**\bin\**;MikoMultiplatformApp\**\obj\**;MikoMultiplatformApp\nuget.config;MikoMultiplatformApp\**\*.user"
             PackagePath="content\MikoMultiplatformApp" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Agent-first assets live in a single authoritative source at the repo root (../agent).
    They are injected into BOTH template content roots at pack time so there is exactly one
    copy in the repo (nothing is duplicated under the templates source dirs in source
    control). The per-agent .template.config modifiers still control which of these ship on
    scaffold via the agent option. agent/README.md documents the source itself and is not
    shipped.
  -->
  <ItemGroup>
    <_AgentAsset Include="..\agent\**\*" Exclude="..\agent\README.md;..\agent\**\.DS_Store" />
    <Content Include="@(_AgentAsset)"
             PackagePath="content\MikoRazorApp\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="@(_AgentAsset)"
             PackagePath="content\MikoMultiplatformApp\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The agent reference *content* is the developer documentation: every Markdown page of ../docs
    ships under .miko/docs/, so agents and developers read the same text and nothing is
    maintained twice. Only Markdown ships — the example .razor files next to the component pages
    would otherwise be compiled into the generated app. Excluded: the VitePress landing page
    and the Ionic theming design notes. Keep in sync with tools/Miko.DocGen/AgentPackageLayout.cs
    (tests/Miko.Docs.Tests fails when the package and the layout disagree).
  -->
  <ItemGroup>
    <_AgentDoc Include="..\docs\**\*.md"
               Exclude="..\docs\node_modules\**;..\docs\.vitepress\**;..\docs\index.md;..\docs\ionic-theme.md" />
    <Content Include="@(_AgentDoc)"
             PackagePath="content\MikoRazorApp\.miko\docs\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="@(_AgentDoc)"
             PackagePath="content\MikoMultiplatformApp\.miko\docs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Scaffolded apps embed Ionicons and the .NET MAUI app icon, so they carry the notices too.
    The package-root copy comes from Directory.Build.props.
  -->
  <ItemGroup>
    <Content Include="..\THIRD-PARTY-NOTICES.txt" PackagePath="content\MikoRazorApp\THIRD-PARTY-NOTICES.txt" />
    <Content Include="..\THIRD-PARTY-NOTICES.txt" PackagePath="content\MikoMultiplatformApp\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- This is a content-only package; nothing here should be compiled. -->
  <ItemGroup>
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
